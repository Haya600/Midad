<!-- Source: composer.json (+ package.json, which only holds Vite tooling - not used by the Blade views) -->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Midad</RootNamespace>
    <AssemblyName>Midad</AssemblyName>
    <!-- Razor views reference ViewModels / Support types; compile them at build time like Blade's cached views -->
    <RazorCompileOnBuild>true</RazorCompileOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- laravel/framework (Eloquent, sqlsrv driver) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11" PrivateAssets="all" />
    <!-- laravel/framework Hash::make (bcrypt, $2y$ compatible) -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <!-- guzzlehttp/guzzle → System.Net.Http.HttpClient (built in, no package) -->
    <!-- laravel/tinker → no equivalent (use `dotnet ef dbcontext` / a REPL such as csi) -->
    <!-- dev: fakerphp/faker → Bogus; laravel/pint → dotnet format; phpunit → xUnit (no tests ported) -->
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\SharedResource.ar.resx" />
    <EmbeddedResource Update="Resources\Validation.ar.resx" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="midad.sql" CopyToOutputDirectory="Never" />
    <Content Update="libman.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
