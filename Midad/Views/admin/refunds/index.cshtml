@* Source: resources/views/admin/refunds/index.blade.php *@
@{
    int pending = Get<int>("pending");
    Paginator<RefundRequest> refunds = Get<Paginator<RefundRequest>>("refunds");
    int total = Get<int>("total");
}
@* Admin: Refund requests (§7 - clone of UC1-02), pending first. *@
@{ Layout = "~/Views/Shared/_LayoutHotel.cshtml"; }
@{ ViewData["title"] = "Refund Requests"; }
@section crumb {<text><b>@(T("Refund Requests"))</b></text>}
@* @section('content') = the Razor body *@
        @await Html.PartialAsync("~/Views/Shared/_FlashHotel.cshtml", With(new Dictionary<string, object?> {  }))
        <div class="ph"><div><h1>@(T("Refund Requests"))</h1><p>@(total) @(total == 1 ? T("request") : T("requests")) · @(T(":n waiting for your decision", new Dictionary<string, object?> { ["n"] = pending }))</p></div></div>
        @await Html.PartialAsync("~/Views/hotel/partials/bar.cshtml", With(new Dictionary<string, object?> { ["statuses"] = new[] { "Pending", "Approved", "Rejected" } }))
        <div class="card-m">
          <div class="md-table-scroll">
          <table class="tbl">
            <thead><tr><th>@(T("Refund"))</th><th>@(T("Hotel"))</th><th>@(T("Supplier"))</th><th>@(T("Order"))</th><th>@(T("Requested"))</th><th class="text-end">@(T("Amount"))</th><th>@(T("Status"))</th><th></th></tr></thead>
            <tbody>
              @if (Php.Any(refunds)) { foreach (var r in refunds) {<text>
              <tr data-href="@(Route("admin.refunds.show", r))">
                <td class="num" style="font-weight:500">RF-@(r.RefundId)</td>
                <td>@(r.Hotel.HotelName)</td>
                <td>@(r.Order.Contract.Bid.Supplier.CompanyName)</td>
                <td class="num">@(r.Order.OrderNo)</td>
                <td class="num">@(r.RequestedAt.TranslatedFormat("d M Y"))</td>
                <td class="text-end num">@(T("SAR")) @(Php.NumberFormat((decimal) r.RequestedAmount, 2))</td>
                <td>@await Html.PartialAsync("~/Views/Shared/_StatusPill.cshtml", Component(new Dictionary<string, object?> { ["value"] = r.RefundStatus }))</td>
                <td class="text-end">@if (r.RefundStatus == "Pending") {<text><a class="btn btn-primary btn-sm" href="@(Route("admin.refunds.show", r))">@(T("Review"))</a></text>} else {<text><a href="@(Route("admin.refunds.show", r))" aria-label="@(T("Open"))"><i class="bi bi-chevron-right" style="color:var(--faint)"></i></a></text>}</td>
              </tr>
              </text>} } else {<text>
              <tr><td colspan="8" style="color:var(--muted)">@(T("No refund requests match this filter."))</td></tr>
              </text>}
            </tbody>
          </table>
          </div>
        </div>
        @await Html.PartialAsync("~/Views/Shared/_PgHotel.cshtml", With(new Dictionary<string, object?> { ["p"] = refunds, ["noun"] = "refund requests" }))
@* @endsection *@
