
@{
    decimal commission = Get<decimal>("commission");
    List<Chart.Point> commissionChart = Get<List<Chart.Point>>("commissionChart");
    string? greeting = Get<string?>("greeting");
    int hotels = Get<int>("hotels");
    int hotelsPending = Get<int>("hotelsPending");
    List<SupplyRequest> latest = Get<List<SupplyRequest>>("latest");
    int openRequests = Get<int>("openRequests");
    List<Hotel> pendingHotels = Get<List<Hotel>>("pendingHotels");
    List<Supplier> pendingSuppliers = Get<List<Supplier>>("pendingSuppliers");
    int refundsPending = Get<int>("refundsPending");
    int suppliers = Get<int>("suppliers");
    int suppliersPending = Get<int>("suppliersPending");
}

@{ Layout = "~/Views/Shared/_LayoutHotel.cshtml"; }
@{ ViewData["title"] = "Admin dashboard"; }
@section crumb {<text><b>@(T("Dashboard"))</b></text>}

        @await Html.PartialAsync("~/Views/Shared/_FlashHotel.cshtml", With(new Dictionary<string, object?> {  }))
        <div class="ph">
          <div><h1>@(greeting)</h1><p>@(T("Midad administration")) · @(Php.Now().TranslatedFormat("l, j F Y"))</p></div>
          <a class="btn btn-primary btn-lg" href="@(Route("admin.refunds.index", new Dictionary<string, object?> { ["status"] = "Pending" }))"><i class="bi bi-arrow-counterclockwise me-2"></i>@(T("Review refunds"))</a>
        </div>

        <div class="row g-3 mb-4">
          <div class="col-12 col-sm-6 col-lg-3"><div class="card-m card-p"><div class="stat-k">@(T("Hotels"))</div><div class="stat-v">@(hotels)</div><div class="stat-d">@(T(":n waiting for verification", new Dictionary<string, object?> { ["n"] = hotelsPending }))</div></div></div>
          <div class="col-12 col-sm-6 col-lg-3"><div class="card-m card-p"><div class="stat-k">@(T("Suppliers"))</div><div class="stat-v">@(suppliers)</div><div class="stat-d">@(T(":n waiting for verification", new Dictionary<string, object?> { ["n"] = suppliersPending }))</div></div></div>
          <div class="col-12 col-sm-6 col-lg-3"><div class="card-m card-p"><div class="stat-k">@(T("Open requests"))</div><div class="stat-v">@(openRequests)</div><div class="stat-d">@(T(refundsPending == 1 ? ":n refund request pending" : ":n refund requests pending", new Dictionary<string, object?> { ["n"] = refundsPending }))</div></div></div>
          <div class="col-12 col-sm-6 col-lg-3"><div class="card-m card-p"><div class="stat-k">@(T("Commission this quarter"))</div><div class="stat-v" style="font-size:25px;">@(T("SAR")) @(Php.NumberFormat(commission))</div><div class="stat-d">@(T("10% of paid invoices"))</div></div></div>
        </div>

        @await Html.PartialAsync("~/Views/Shared/_BarChart.cshtml", Component(new Dictionary<string, object?> { ["title"] = "Commission revenue by month", ["sub"] = "Last 6 months · 10% of paid invoices", ["points"] = commissionChart, ["empty"] = "No paid invoices in the last 6 months." }))

        @if (pendingHotels.IsNotEmpty() || pendingSuppliers.IsNotEmpty()) {<text>
        <div class="card-m mb-4">
          <div class="card-h"><div class="card-t">@(T("Waiting for verification"))</div><span style="font-size:13px;color:var(--muted)">@(T("Check the commercial registration, then verify"))</span></div>
          <div class="md-table-scroll">
          <table class="tbl">
            <thead><tr><th>@(T("Business"))</th><th>@(T("Type"))</th><th>@(T("City"))</th><th>@(T("CR number"))</th><th>@(T("Registered"))</th><th></th></tr></thead>
            <tbody>
              @foreach (var $kind, $list] in new[] { new[] { "hotels", pendingHotels }, new[] { "suppliers", pendingSuppliers } }) {<text>
                @foreach (var p in list) {<text>
                <tr data-href="@(Route($"admin.{kind}.edit", p.GetKey()))">
                  <td style="font-weight:500">@(p.HotelName ?? p.CompanyName)</td><td>@(T(kind == "hotels" ? "Hotel" : "Supplier"))</td><td>@(T(p.City))</td><td class="num">@(p.CommercialRegNo)</td><td class="num">@(p.User.CreatedAt.TranslatedFormat("d M Y"))</td>
                  <td class="text-end" style="white-space:nowrap"><form method="POST" action="@(Route($"admin.{kind}.verify", p.GetKey()))" class="d-inline">@Html.AntiForgeryToken()<button class="btn btn-accent btn-sm" type="submit">@(T("Verify"))</button></form></td>
                </tr>
                </text>}
              </text>}
            </tbody>
          </table>
          </div>
        </div>
        </text>}

        <div class="card-m">
          <div class="card-h"><div class="card-t">@(T("Recent supply requests"))</div><a class="btn btn-ghost btn-sm" href="@(Route("admin.requests.index"))">@(T("View all"))</a></div>
          <div class="md-table-scroll">
          <table class="tbl">
            <thead><tr><th>@(T("Request"))</th><th>@(T("Hotel"))</th><th>@(T("Product"))</th><th>@(T("Needed by"))</th><th>@(T("Priority"))</th><th class="text-end">@(T("Bids"))</th><th>@(T("Status"))</th></tr></thead>
            <tbody>
              @foreach (var r in latest) {<text>
              <tr data-href="@(Route("admin.requests.show", r))"><td class="num" style="font-weight:500">@(r.Code)</td><td>@(r.Hotel.HotelName)</td><td>@await Html.PartialAsync("~/Views/hotel/requests/_product.cshtml", With(new Dictionary<string, object?> { ["r"] = r }))</td><td class="num">@(r.RequiredDeliveryDate.TranslatedFormat("d M Y"))</td><td>@await Html.PartialAsync("~/Views/Shared/_StatusPill.cshtml", Component(new Dictionary<string, object?> { ["value"] = r.Priority, ["priority"] = true }))</td><td class="text-end num">@(r.Bids.Count)</td><td>@await Html.PartialAsync("~/Views/Shared/_StatusPill.cshtml", Component(new Dictionary<string, object?> { ["value"] = r.RequestStatus }))</td></tr>
              </text>}
            </tbody>
          </table>
          </div>
        </div>

