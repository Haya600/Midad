
@{
    Admin admin = Get<Admin>("admin");
    string? phone = Get<string?>("phone");
    UserAccount user = Get<UserAccount>("user");
}

@{ Layout = "~/Views/Shared/_LayoutHotel.cshtml"; }
@{ ViewData["title"] = "My Account"; }
@section crumb {<text><b>@(T("My Account"))</b></text>}
@{ var phoneErr = errors.First("phone") ?? errors.First("phone_local"); }

        @await Html.PartialAsync("~/Views/Shared/_FlashHotel.cshtml", With(new Dictionary<string, object?> {  }))
        <div class="ph"><div><h1>@(T("My Account"))</h1><p>@(admin.EmployeeNo) · @(T("administrator since :date", new Dictionary<string, object?> { ["date"] = user.CreatedAt.TranslatedFormat("j M Y") }))</p></div></div>
        <div class="row g-4">
          <div class="col-12 col-lg-8">
            <form method="POST" action="@(Route("admin.account.update"))">
              @Html.AntiForgeryToken() <input type="hidden" name="_method" value="PUT">
              <div class="card-m card-p mb-3">
                <div class="card-t mb-3">@(T("Details"))</div>
                <div class="row g-3">
                  @await Html.PartialAsync("~/Views/Shared/_Field.cshtml", Component(new Dictionary<string, object?> { ["shell"] = "hotel", ["col"] = "col-12 col-md-4", ["name"] = "first_name", ["label"] = "First name", ["value"] = admin.FirstName, ["required"] = true, ["maxlength"] = "50" }))
                  @await Html.PartialAsync("~/Views/Shared/_Field.cshtml", Component(new Dictionary<string, object?> { ["shell"] = "hotel", ["col"] = "col-12 col-md-4", ["name"] = "last_name", ["label"] = "Last name", ["value"] = admin.LastName, ["required"] = true, ["maxlength"] = "50" }))
                  @await Html.PartialAsync("~/Views/Shared/_Field.cshtml", Component(new Dictionary<string, object?> { ["shell"] = "hotel", ["col"] = "col-12 col-md-4", ["name"] = "employee_no", ["label"] = "Employee number", ["type"] = "static", ["value"] = admin.EmployeeNo, ["hint"] = "Set by Midad" }))
                  @await Html.PartialAsync("~/Views/Shared/_Field.cshtml", Component(new Dictionary<string, object?> { ["shell"] = "hotel", ["col"] = "col-12 col-md-6", ["name"] = "email", ["label"] = "Email address", ["type"] = "email", ["value"] = user.Email, ["hint"] = "Used to log in · must be unique", ["required"] = true, ["maxlength"] = "150" }))
                  <div class="col-12 col-md-6"><label class="lbl" for="phone">@(T("Phone")) <span class="req">*</span></label><input id="phone" name="phone" type="tel" value="@(Old("phone", phone))" placeholder="@(T("5X XXX XXXX"))" required inputmode="numeric" maxlength="12" pattern="^0?5[0-9]\s?[0-9]{3}\s?[0-9]{4}$" title="@(T("5X XXX XXXX"))" class="fld @Html.Raw((Php.B(phoneErr)) ? $" fld-err " : "")">@if (Php.B(phoneErr)) {<text><div class="err"><i class="bi bi-exclamation-circle me-1"></i>@(phoneErr)</div></text>} else {<text><div class="help">@(T("Saudi mobile, +966 is added"))</div></text>}</div>
                </div>
                <div class="card-t mb-3 mt-3" style="padding-top:20px;border-top:1px solid var(--border)">@(T("Change password"))</div>
                <div class="row g-3">
                  @await Html.PartialAsync("~/Views/Shared/_Field.cshtml", Component(new Dictionary<string, object?> { ["shell"] = "hotel", ["col"] = "col-12 col-md-6", ["name"] = "password", ["label"] = "New password", ["type"] = "password", ["placeholder"] = $"{Php.E(T("Leave empty to keep it"))}", ["hint"] = "At least 8 characters, one number", ["minlength"] = "8", ["pattern"] = "^(?=.*[A-Za-z])(?=.*\d).{8,}$", ["title"] = $"{Php.E(T("At least 8 characters, one number"))}", ["autocomplete"] = "new-password" }))
                  @await Html.PartialAsync("~/Views/Shared/_Field.cshtml", Component(new Dictionary<string, object?> { ["shell"] = "hotel", ["col"] = "col-12 col-md-6", ["name"] = "password_confirmation", ["label"] = "Confirm password", ["type"] = "password", ["placeholder"] = "••••••••", ["minlength"] = "8", ["autocomplete"] = "new-password" }))
                </div>
              </div>
              <div class="foot" style="margin-top:0;border-top:0;padding-top:0">
                <a class="btn btn-ghost" href="@(Route("admin.dashboard"))"><i class="bi bi-arrow-left me-2"></i>@(T("Back"))</a>
                <div class="d-flex gap-2"><button class="btn btn-primary" type="submit">@(T("Save changes"))</button></div>
              </div>
            </form>
          </div>
          <div class="col-12 col-lg-4">
            <div class="card-m card-p">
              <div class="card-t mb-3">@(T("Your activity"))</div>
              <dl class="kv mb-0">
                <dt>@(T("Refunds verified"))</dt><dd class="num">@(admin.RefundRequests.Count())</dd>
                <dt>@(T("Account status"))</dt><dd style="margin-bottom:0">@await Html.PartialAsync("~/Views/Shared/_StatusPill.cshtml", Component(new Dictionary<string, object?> { ["value"] = user.AccountStatus }))</dd>
              </dl>
            </div>
          </div>
        </div>

