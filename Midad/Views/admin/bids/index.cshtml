@* Source: resources/views/admin/bids/index.blade.php *@
@{
    Paginator<Bid> bids = Get<Paginator<Bid>>("bids");
    int total = Get<int>("total");
}
@* Admin: Bids (§7 - clone of UC1-02): view / cancel / delete. *@
@{ Layout = "~/Views/Shared/_LayoutHotel.cshtml"; }
@{ ViewData["title"] = "Bids"; }
@section crumb {<text><b>@(T("Bids"))</b></text>}
@* @section('content') = the Razor body *@
        @await Html.PartialAsync("~/Views/Shared/_FlashHotel.cshtml", With(new Dictionary<string, object?> {  }))
        <div class="ph"><div><h1>@(T("Bids"))</h1><p>@(T(":n bids from all suppliers", new Dictionary<string, object?> { ["n"] = total }))</p></div></div>
        @await Html.PartialAsync("~/Views/hotel/partials/bar.cshtml", With(new Dictionary<string, object?> { ["statuses"] = new[] { "Submitted", "Accepted", "Rejected", "Cancelled" }, ["search"] = "Search by supplier or request" }))
        <div class="card-m">
          <div class="md-table-scroll">
          <table class="tbl">
            <thead><tr><th>@(T("Request"))</th><th>@(T("Hotel"))</th><th>@(T("Supplier"))</th><th class="text-end">@(T("Price"))</th><th class="text-end">@(T("Delivery"))</th><th>@(T("Submitted"))</th><th>@(T("Status"))</th><th></th></tr></thead>
            <tbody>
              @if (Php.Any(bids)) { foreach (var b in bids) {<text>
              <tr>
                <td class="num" style="font-weight:500"><a href="@(Route("admin.requests.show", b.RequestId))" class="md-link" style="color:inherit">@(b.Request.Code)</a></td>
                <td>@(b.Request.Hotel.HotelName)</td>
                <td>@(b.Supplier.CompanyName)</td>
                <td class="text-end num">@(T("SAR")) @(Php.NumberFormat((decimal) b.BidPrice, 2))</td>
                <td class="text-end num">@(b.EstimatedDeliveryDays) @(T("days"))</td>
                <td class="num">@(b.CreatedAt.TranslatedFormat("d M Y"))</td>
                <td>@await Html.PartialAsync("~/Views/Shared/_StatusPill.cshtml", Component(new Dictionary<string, object?> { ["value"] = b.BidStatus }))</td>
                <td class="text-end" style="white-space:nowrap">
                  @if (b.BidStatus == "Submitted" && !Php.B(b.Contract)) {<text>
                  <form method="POST" action="@(Route("admin.bids.cancel", b))" class="d-inline">@Html.AntiForgeryToken()<button class="btn btn-white btn-sm" type="submit">@(T("Cancel"))</button></form>
                  </text>}
                  @if (Can("delete", b)) {<text>
                  <form method="POST" action="@(Route("admin.bids.destroy", b))" class="d-inline" onsubmit="return confirm('Delete this bid? This cannot be undone.')">@Html.AntiForgeryToken() <input type="hidden" name="_method" value="DELETE"><button class="btn btn-white btn-sm" type="submit" style="color:var(--danger)" aria-label="@(T("Delete bid"))"><i class="bi bi-trash"></i></button></form>
                  </text>}
                </td>
              </tr>
              </text>} } else {<text>
              <tr><td colspan="8" style="color:var(--muted)">@(T("No bids match these filters."))</td></tr>
              </text>}
            </tbody>
          </table>
          </div>
        </div>
        @await Html.PartialAsync("~/Views/Shared/_PgHotel.cshtml", With(new Dictionary<string, object?> { ["p"] = bids, ["noun"] = "bids" }))
@* @endsection *@
