
@{
    Contract? contract = Get<Contract?>("contract");
    SupplyRequest sr = Get<SupplyRequest>("sr");
}

@{ Layout = "~/Views/Shared/_LayoutHotel.cshtml"; }
@{ ViewData["title"] = sr.Code; }
@section crumb {<text><a href="@(Route("admin.requests.index"))" class="md-link" style="color:inherit">@(T("Supply Requests"))</a> <span style="color:var(--faint)">/</span> <b>@(sr.Code)</b></text>}

        @await Html.PartialAsync("~/Views/Shared/_FlashHotel.cshtml", With(new Dictionary<string, object?> {  }))
        <div class="ph">
          <div>
            <div class="d-flex align-items-center gap-3 mb-1 flex-wrap"><h1>@(sr.Code)</h1>@await Html.PartialAsync("~/Views/Shared/_StatusPill.cshtml", Component(new Dictionary<string, object?> { ["value"] = sr.RequestStatus }))@await Html.PartialAsync("~/Views/Shared/_StatusPill.cshtml", Component(new Dictionary<string, object?> { ["value"] = sr.Priority, ["priority"] = true }))</div>
            <p>@(sr.Hotel.HotelName) · @(T("created :date", new Dictionary<string, object?> { ["date"] = sr.CreatedAt.TranslatedFormat("j M Y, H:i") })) · @(T("by :name", new Dictionary<string, object?> { ["name"] = sr.RequestedBy }))</p>
          </div>
          <div class="d-flex gap-2">
            @if (Can("cancel", sr)) {<text><button class="btn btn-white" type="button" style="color:var(--danger)" data-md-open="#confirmCancel"><i class="bi bi-x-lg me-2"></i>@(T("Cancel request"))</button></text>}
            @if (Can("delete", sr)) {<text><button class="btn btn-white" type="button" style="color:var(--danger)" data-md-open="#confirmDelete"><i class="bi bi-trash me-2"></i>@(T("Delete"))</button></text>}
          </div>
        </div>
        <div class="row g-4">
          <div class="col-12 col-lg-8">
            <div class="card-m mb-3">
              <div class="card-h"><div class="card-t">@(T("Items requested"))</div><span style="font-size:13px;color:var(--muted)">@(sr.ItemsSummary())</span></div>
              <div class="md-table-scroll">
              <table class="tbl">
                <thead><tr><th>#</th><th>@(T("Product"))</th><th>@(T("Category"))</th><th class="text-end">@(T("Quantity"))</th><th>@(T("Specifications"))</th></tr></thead>
                <tbody>
                  @foreach (var (s, loop) in Php.Loop(sr.Supplies)) {<text>
                  <tr><td class="num" style="color:var(--muted)">@(loop.Iteration)</td><td style="font-weight:500">@(s.SupplyName)</td><td>@(s.Category)</td><td class="text-end num">@(Php.NumberFormat(s.Quantity)) @(s.UnitOfMeasure)</td><td style="color:var(--muted);font-size:13px;">@(s.Description)</td></tr>
                  </text>}
                </tbody>
              </table>
              </div>
            </div>
            <div class="card-m">
              <div class="card-h"><div class="card-t">@(T("Bids"))</div><span style="font-size:13px;color:var(--muted)">@(T("Best bid first · price, then delivery time"))</span></div>
              <div class="md-table-scroll">
              <table class="tbl">
                <thead><tr><th>#</th><th>@(T("Supplier"))</th><th class="text-end">@(T("Price (excl. VAT)"))</th><th class="text-end">@(T("Delivery"))</th><th>@(T("Submitted"))</th><th>@(T("Status"))</th></tr></thead>
                <tbody>
                  @if (Php.Any(sr.BidsRanked)) { foreach (var (b, loop) in Php.Loop(sr.BidsRanked)) {<text>
                  <tr><td class="num" style="color:var(--muted)">@(loop.Iteration)</td><td style="font-weight:500">@(b.Supplier.CompanyName)</td><td class="text-end num">@(T("SAR")) @(Php.NumberFormat((decimal) b.BidPrice, 2))</td><td class="text-end num">@(b.EstimatedDeliveryDays) @(T("days"))</td><td class="num">@(b.CreatedAt.TranslatedFormat("d M Y"))</td><td>@await Html.PartialAsync("~/Views/Shared/_StatusPill.cshtml", Component(new Dictionary<string, object?> { ["value"] = b.BidStatus }))</td></tr>
                  </text>} } else {<text>
                  <tr><td colspan="6" style="color:var(--muted)">@(T("No bids yet."))</td></tr>
                  </text>}
                </tbody>
              </table>
              </div>
            </div>
          </div>
          <div class="col-12 col-lg-4">
            <div class="card-m card-p mb-3">
              <div class="card-t mb-3">@(T("Request details"))</div>
              <dl class="kv mb-0">
                <dt>@(T("Hotel"))</dt><dd>@(sr.Hotel.HotelName) · @(T(sr.Hotel.City))</dd>
                <dt>@(T("Required delivery date"))</dt><dd class="num">@(sr.RequiredDeliveryDate.TranslatedFormat("d M Y"))</dd>
                <dt>@(T("Priority"))</dt><dd>@(sr.Priority)</dd>
                <dt>@(T("Contract"))</dt><dd class="num" style="margin-bottom:0">@if (Php.B(contract)) {<text>@(contract.ContractNo) @await Html.PartialAsync("~/Views/Shared/_StatusPill.cshtml", Component(new Dictionary<string, object?> { ["value"] = contract.ContractStatus, ["class"] = "ms-1" }))</text>} else {<text><span style="color:var(--faint);font-weight:400">@(T("None"))</span></text>}</dd>
              </dl>
            </div>
          </div>
        </div>

@{ Push("modals", @<text>
  @if (Can("cancel", sr)) {<text>
  @await Html.PartialAsync("~/Views/hotel/partials/confirm.cshtml", With(new Dictionary<string, object?> { ["id"] = "confirmCancel", ["title"] = T("Cancel :code?", new Dictionary<string, object?> { ["code"] = sr.Code }), ["text"] = "Suppliers can no longer bid. Active bids are rejected and any unsigned contract is cancelled. The hotel sees the request as Cancelled.", ["action"] = Route("admin.requests.cancel", sr), ["button"] = "Cancel request", ["btnClass"] = "btn-danger", ["keep"] = "Keep request" }))
  </text>}
  @if (Can("delete", sr)) {<text>
  @await Html.PartialAsync("~/Views/hotel/partials/confirm.cshtml", With(new Dictionary<string, object?> { ["id"] = "confirmDelete", ["title"] = T("Delete :code?", new Dictionary<string, object?> { ["code"] = sr.Code }), ["text"] = "The request and its items are removed. This cannot be undone.", ["action"] = Route("admin.requests.destroy", sr), ["method"] = "DELETE", ["button"] = "Delete", ["btnClass"] = "btn-danger", ["keep"] = "Keep request" }))
  </text>}
</text>); }
