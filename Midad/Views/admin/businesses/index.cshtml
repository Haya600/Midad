
@{
    string? kind = Get<string?>("kind");
    int pending = Get<int>("pending");
    dynamic rows = ViewBag.rows;
    int total = Get<int>("total");
}

@{ Layout = "~/Views/Shared/_LayoutHotel.cshtml"; }
@{ var title = kind == "hotels" ? "Hotels" : "Suppliers"; }
@{ ViewData["title"] = title; }
@section crumb {<text><b>@(T(title))</b></text>}

        @await Html.PartialAsync("~/Views/Shared/_FlashHotel.cshtml", With(new Dictionary<string, object?> {  }))
        <div class="ph">
          <div><h1>@(T(title))</h1><p>@(T(":n registered · :m waiting for verification", new Dictionary<string, object?> { ["n"] = total, ["m"] = pending }))</p></div>
        </div>
        @await Html.PartialAsync("~/Views/hotel/partials/bar.cshtml", With(new Dictionary<string, object?> { ["statuses"] = new[] { "Pending", "Verified", "Rejected" }, ["search"] = kind == "hotels" ? "Search hotels, CR or city" : "Search suppliers, CR or city" }))
        <div class="card-m">
          <div class="md-table-scroll">
          <table class="tbl">
            <thead><tr><th>@(T(kind == "hotels" ? "Hotel" : "Company"))</th><th>@(T("City"))</th><th>@(T("CR number"))</th><th>@(T("Contact"))</th><th>@(T(kind == "hotels" ? "Email" : "Rating"))</th><th>@(T("Profile"))</th><th>@(T("Account"))</th><th></th></tr></thead>
            <tbody>
              @if (Php.Any(rows)) { foreach (var p in rows) {<text>
              <tr data-href="@(Route($"admin.{kind}.edit", p.GetKey()))">
                <td style="font-weight:500">@(p.HotelName ?? p.CompanyName)@if (kind == "suppliers") {<text><div style="font-size:12px;color:var(--muted);font-weight:400">@(p.SupplyCategories)</div></text>}</td>
                <td>@(T(p.City))</td>
                <td class="num">@(p.CommercialRegNo)</td>
                <td>@(p.ContactPerson)<div style="font-size:12px;color:var(--muted)">@(MidadPhone.Display(p.User.Phone))</div></td>
                <td>@if (kind == "hotels") {<text>@(p.User.Email)</text>} else {<text><i class="bi bi-star-fill" style="color:var(--warn)"></i> @(Php.NumberFormat((decimal) p.AvgRating, 1))</text>}</td>
                <td>@await Html.PartialAsync("~/Views/Shared/_StatusPill.cshtml", Component(new Dictionary<string, object?> { ["value"] = p.ProfileStatus }))</td>
                <td>@await Html.PartialAsync("~/Views/Shared/_StatusPill.cshtml", Component(new Dictionary<string, object?> { ["value"] = p.User.AccountStatus }))</td>
                <td class="text-end" style="white-space:nowrap">@if (p.ProfileStatus == "Pending") {<text><form method="POST" action="@(Route($"admin.{kind}.verify", p.GetKey()))" class="d-inline">@Html.AntiForgeryToken()<button class="btn btn-accent btn-sm" type="submit">@(T("Verify"))</button></form></text>} else {<text><a href="@(Route($"admin.{kind}.edit", p.GetKey()))" aria-label="@(T("Open"))"><i class="bi bi-chevron-right" style="color:var(--faint)"></i></a></text>}</td>
              </tr>
              </text>} } else {<text>
              <tr><td colspan="8" style="color:var(--muted)">@(T("No :items match these filters.", new Dictionary<string, object?> { ["items"] = T(Php.Strtolower(title)) }))</td></tr>
              </text>}
            </tbody>
          </table>
          </div>
        </div>
        @await Html.PartialAsync("~/Views/Shared/_PgHotel.cshtml", With(new Dictionary<string, object?> { ["p"] = rows, ["noun"] = Php.Strtolower(title) }))

