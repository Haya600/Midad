
@{
    Contract? contract = Get<Contract?>("contract");
}

@{ Layout = "~/Views/Shared/_LayoutSupplier.cshtml"; }
@{ ViewData["title"] = contract.ContractNo; }
@{ var bid = contract.Bid; }
@{ var sr = bid.Request; }
@{ var order = contract.PurchaseOrder; }

    <div class="body-pad"><div class="wrap">
      <div class="crumb"><a href="@(Route("supplier.contracts.index"))" class="md-link" style="color:inherit">@(T("Contracts"))</a> <span style="color:var(--faint)">/</span> <b>@(contract.ContractNo)</b></div>
      @await Html.PartialAsync("~/Views/Shared/_FlashSite.cshtml", With(new Dictionary<string, object?> {  }))
      <div class="d-flex align-items-start justify-content-between mb-5 flex-wrap" style="gap:24px">
        <div>
          <div class="d-flex align-items-center gap-3 mb-3"><span class="rq-no">@(contract.ContractNo)</span>@await Html.PartialAsync("~/Views/Shared/_StatusPill.cshtml", Component(new Dictionary<string, object?> { ["shell"] = "supplier", ["value"] = contract.ContractStatus }))</div>
          <h1 class="pg-h1">@(sr.Title)</h1>
          <p class="pg-sub">@(sr.Hotel.HotelName) · @(sr.Code) · @(T("generated :date", new Dictionary<string, object?> { ["date"] = contract.GeneratedAt.TranslatedFormat("j M Y, H:i") }))</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
          <a class="btn b-line" href="@(Route("contracts.document", contract))" target="_blank" rel="noopener"><i class="bi bi-printer"></i>@(T("Print contract"))</a>
          @if (Can("sign", contract)) {<text><button class="btn b-olive" type="button" data-md-open="#signContract"><i class="bi bi-pen"></i>@(T("Sign contract"))</button></text>}
        </div>
      </div>
      <div class="row g-4">
        <div class="col-12 col-lg-8">
          <div class="cd mb-4"><div class="cd-p"><div class="row g-4">
            <div class="col-6 col-md-3"><div class="k">@(T("Contract value"))</div><div class="num" style="font-size:24px;font-weight:800;letter-spacing:-.025em;margin-top:6px">@(T("SAR")) @(Php.NumberFormat((decimal) contract.ContractValue))</div><div style="font-size:12.5px;color:var(--muted);margin-top:4px">@(T("Excluding VAT"))</div></div>
            <div class="col-6 col-md-3"><div class="k">@(T("Total to hotel"))</div><div class="num" style="font-size:24px;font-weight:800;letter-spacing:-.025em;margin-top:6px">@(T("SAR")) @(Php.NumberFormat((decimal) contract.ContractValue * (1 + Config("midad.vat_rate"))))</div><div style="font-size:12.5px;color:var(--muted);margin-top:4px">@(T("VAT at 15% included"))</div></div>
            <div class="col-6 col-md-3"><div class="k">@(T("Delivery"))</div><div class="num" style="font-size:24px;font-weight:800;letter-spacing:-.025em;margin-top:6px">@(bid.EstimatedDeliveryDays) @(T("days"))</div><div style="font-size:12.5px;color:var(--muted);margin-top:4px">@(T("From signature"))</div></div>
            <div class="col-6 col-md-3"><div class="k">@(T("Deliver by"))</div><div class="num" style="font-size:20px;font-weight:700;margin-top:8px">@(contract.AgreedDeliveryDate.TranslatedFormat("d M Y"))</div></div>
          </div></div></div>
          <div class="cd">
            <div class="cd-h"><div class="cd-t">@(T("Items covered"))</div><span style="font-size:14px;color:var(--muted);font-weight:500">@(sr.ItemsSummary())</span></div>
            <div class="md-table-scroll">
            <table class="tb">
              <thead><tr><th>#</th><th>@(T("Product"))</th><th class="text-end">@(T("Quantity"))</th></tr></thead>
              <tbody>
                @foreach (var (s, loop) in Php.Loop(sr.Supplies)) {<text>
                <tr><td class="num" style="color:var(--faint)">@(loop.Iteration)</td><td><div style="font-weight:700">@(s.SupplyName)</div>@if (Php.B(s.Description)) {<text><div style="font-size:13.5px;color:var(--muted);margin-top:4px">@(s.Description)</div></text>}</td><td class="text-end num">@(Php.NumberFormat(s.Quantity)) @(s.UnitOfMeasure)</td></tr>
                </text>}
              </tbody>
            </table>
            </div>
          </div>
        </div>
        <div class="col-12 col-lg-4">
          <div class="cd cd-p mb-3">
            <div class="cd-t mb-4">@(T("Signatures"))</div>
            <dl class="kv mb-0">
              <dt>@(T("Hotel"))</dt><dd class="num">@Html.Raw(contract.HotelSignedAt ? Php.E(contract.HotelSignedAt.TranslatedFormat("j M Y, H:i")) : "<span style=\"color:var(--faint);font-weight:500\">" + Php.E(T("Not signed yet")) + "</span>")</dd>
              <dt>@(T("Supplier"))</dt><dd class="num">@Html.Raw(contract.SupplierSignedAt ? Php.E(contract.SupplierSignedAt.TranslatedFormat("j M Y, H:i")) : "<span style=\"color:var(--faint);font-weight:500\">" + Php.E(T("Not signed yet")) + "</span>")</dd>
              <dt>@(T("Signed copy"))</dt><dd style="margin-bottom:0">@if (Php.B(contract.DocumentSrc)) {<text><a href="@(contract.DocumentSrc)" target="_blank" rel="noopener" class="link" style="font-size:14px"><i class="bi bi-file-earmark-pdf me-1"></i>@(T("Open PDF"))</a></text>} else {<text><span style="color:var(--faint);font-weight:500">@(T("None uploaded yet"))</span></text>}</dd>
            </dl>
          </div>
          @if (Php.B(order)) {<text>
          <div class="cd cd-p mb-3">
            <div class="cd-t mb-4">@(T("Purchase order"))</div>
            <dl class="kv mb-4">
              <dt>@(T("Order"))</dt><dd class="num">@(order.OrderNo) @await Html.PartialAsync("~/Views/Shared/_StatusPill.cshtml", Component(new Dictionary<string, object?> { ["shell"] = "supplier", ["value"] = order.OrderStatus, ["class"] = "ms-1" }))</dd>
              <dt>@(T("Invoice"))</dt><dd class="num" style="margin-bottom:0">@(order.Invoice?.InvoiceNo)</dd>
            </dl>
            <a class="btn b-olive btn-sm" href="@(Route("supplier.orders.show", order))">@(T("Open order"))</a>
          </div>
          </text>} else {<text>
          <div class="al a-info"><i class="bi bi-info-circle-fill"></i><div><div class="al-t">@(T("What happens next"))</div><div class="al-b">@(T("Print the contract, sign it, and upload the signed PDF. When both parties have signed, the purchase order and invoice are created automatically."))</div></div></div>
          </text>}
        </div>
      </div>
    </div></div>


@{ Push("modals", @<text>
@if (Can("sign", contract)) {<text>
<div class="md-modal" id="signContract" hidden role="dialog" aria-modal="true" aria-labelledby="signContractT" @Html.Raw((Php.B(errors.HasAny(new[] { "contract_file", "agree" }))) ? $" data-md-autoshow " : "")>
    <div class="scrim"><form class="mdl" method="POST" action="@(Route("supplier.contracts.sign", contract))" enctype="multipart/form-data">
      @Html.AntiForgeryToken()
      <div class="mdl-h"><div class="mdl-t" id="signContractT">@(T("Sign contract :no?", new Dictionary<string, object?> { ["no"] = contract.ContractNo }))</div></div>
      <div class="mdl-b">
        <p style="margin:0 0 20px;">@(T("Upload the contract signed by your authorised signatory. Your signature is recorded with today's date."))</p>
        <div class="box mb-4">
          <div class="br mb-3"><span style="color:var(--muted)">@(T("Hotel"))</span><span style="font-weight:600">@(sr.Hotel.HotelName)</span></div>
          <div class="br mb-3"><span style="color:var(--muted)">@(T("Contract value"))</span><span class="num" style="font-weight:800;font-size:16px">@(T("SAR")) @(Php.NumberFormat((decimal) contract.ContractValue, 2))</span></div>
          <div class="br"><span style="color:var(--muted)">@(T("Deliver by"))</span><span class="num">@(contract.AgreedDeliveryDate.TranslatedFormat("d M Y"))</span></div>
        </div>
        @await Html.PartialAsync("~/Views/Shared/_Field.cshtml", Component(new Dictionary<string, object?> { ["shell"] = "supplier", ["col"] = "fgrp", ["name"] = "contract_file", ["label"] = "Signed contract", ["type"] = "file", ["accept"] = "application/pdf,.pdf", ["hint"] = "PDF, up to 5 MB", ["required"] = true }))
        <label style="font-size:14px;color:var(--ink-2);display:block"><input type="checkbox" name="agree" value="1" class="md-cb" required><i class="bi bi-square me-2" style="color:var(--line-2)"></i><i class="bi bi-check-square-fill me-2" style="color:var(--olive)"></i>@(T("I agree to the terms of this contract on behalf of :name.", new Dictionary<string, object?> { ["name"] = Auth().User.Supplier.CompanyName }))</label>
        @if (errors.Has("agree")) { var message = errors.First("agree"); <text><div class="emsg"><i class="bi bi-exclamation-circle me-1"></i>@(T(message))</div></text>}
      </div>
      <div class="mdl-f">
        <button class="btn b-line" type="button" data-md-close>@(T("Not now"))</button>
        <button class="btn b-olive" type="submit"><i class="bi bi-pen"></i>@(T("Sign contract"))</button>
      </div>
    </form></div>
</div>
</text>}
</text>); }
