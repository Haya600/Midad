
@{
    List<Contract> contracts = Get<List<Contract>>("contracts");
    int toSign = Get<int>("toSign");
}

@{ Layout = "~/Views/Shared/_LayoutSupplier.cshtml"; }
@{ ViewData["title"] = "Contracts"; }

    <div class="body-pad"><div class="wrap">
      @await Html.PartialAsync("~/Views/Shared/_FlashSite.cshtml", With(new Dictionary<string, object?> {  }))
      <div class="sect-head" style="margin-bottom:32px">
        <div><h1 class="pg-h1">@(T("Contracts"))</h1><p class="pg-sub">@(T(contracts.Count() == 1 ? ":n contract" : ":n contracts", new Dictionary<string, object?> { ["n"] = contracts.Count() })) · @(T(":n waiting for your signature", new Dictionary<string, object?> { ["n"] = toSign }))</p></div>
      </div>
      @if (Php.Any(contracts)) { foreach (var c in contracts) {<text>
        @{ var r = c.Bid.Request; }
        @{ var mustSign = c.ContractStatus == "Pending Signatures" && ! c.SupplierSignedAt; }
      <article class="@Css(("rq", true), ("rq-feat", mustSign), ("rq-dim", c.ContractStatus == "Cancelled"))">
        @await Html.PartialAsync("~/Views/supplier/partials/thumb.cshtml", With(new Dictionary<string, object?> { ["s"] = r.Supplies.First() }))
        <div class="rq-b">
          <div class="rq-top"><span class="rq-no">@(c.ContractNo)</span><span class="rq-hotel">@(r.Hotel.HotelName) · @(r.Code)</span>@await Html.PartialAsync("~/Views/Shared/_StatusPill.cshtml", Component(new Dictionary<string, object?> { ["shell"] = "supplier", ["value"] = c.ContractStatus }))</div>
          <h3 class="rq-h"><a href="@(Route("supplier.contracts.show", c))" class="md-link" style="color:inherit">@(r.Title)</a></h3>
          <div class="rq-s">@if (Php.B(mustSign)) {<text>@(T("Waiting for your signature."))</text>} else if (c.ContractStatus == "Pending Signatures") {<text>@(T("You signed. Waiting for the hotel's signature."))</text>} else if (c.ContractStatus == "Signed") {<text>@(T("Signed by both parties · purchase order :no", new Dictionary<string, object?> { ["no"] = c.PurchaseOrder?.OrderNo }))</text>} else {<text>@(T("Cancelled before both parties signed."))</text>}</div>
          <div class="rq-f">
            <span class="mt"><i class="bi bi-tag"></i>@(T("Value")) <b>@(T("SAR")) @(Php.NumberFormat((decimal) c.ContractValue, 2))</b></span>
            <span class="mt"><i class="bi bi-calendar3"></i>@(T("Deliver by")) <b>@(c.AgreedDeliveryDate.TranslatedFormat("d M Y"))</b></span>
            <span class="rq-cta">@if (Php.B(mustSign)) {<text><a class="btn b-olive" href="@(Route("supplier.contracts.show", c))"><i class="bi bi-pen"></i>@(T("Sign contract"))</a></text>} else {<text><a class="btn b-line" href="@(Route("supplier.contracts.show", c))">@(T("View contract"))</a></text>}</span>
          </div>
        </div>
      </article>
      </text>} } else {<text>
      <div class="lock">@(T("No contracts yet. A contract is generated when a hotel accepts one of your bids."))</div>
      </text>}
    </div></div>

