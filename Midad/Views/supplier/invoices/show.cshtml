@* Source: resources/views/supplier/invoices/show.blade.php *@
@{
    Invoice invoice = Get<Invoice>("invoice");
}
@* Supplier: Invoice detail (§7 - UC2-08 layout): VAT, Midad's 10 % commission and the payout. *@
@{ Layout = "~/Views/Shared/_LayoutSupplier.cshtml"; }
@{ ViewData["title"] = invoice.InvoiceNo; }
@{ var order = invoice.Order; }
@{ var sr = order.Contract.Bid.Request; }
@{ var payout = (decimal) invoice.SubtotalAmount - (decimal) invoice.CommissionAmount; }
@* @section('content') = the Razor body *@
    <div class="body-pad"><div class="wrap">
      <div class="crumb"><a href="@(Route("supplier.invoices.index"))" class="md-link" style="color:inherit">@(T("Invoices"))</a> <span style="color:var(--faint)">/</span> <b>@(invoice.InvoiceNo)</b></div>
      <div class="d-flex align-items-start justify-content-between mb-5 flex-wrap" style="gap:24px">
        <div>
          <div class="d-flex align-items-center gap-3 mb-3"><span class="rq-no">@(invoice.InvoiceNo)</span>@await Html.PartialAsync("~/Views/Shared/_StatusPill.cshtml", Component(new Dictionary<string, object?> { ["shell"] = "supplier", ["value"] = invoice.InvoiceStatus }))</div>
          <h1 class="pg-h1">@(sr.Title)</h1>
          <p class="pg-sub">@(sr.Hotel.HotelName) · @(T("order :no", new Dictionary<string, object?> { ["no"] = order.OrderNo })) · @(T("issued :date", new Dictionary<string, object?> { ["date"] = invoice.IssueDate.TranslatedFormat("j M Y") }))</p>
        </div>
        <a class="btn b-line" href="@(Route("supplier.orders.show", order))">@(T("Open order"))</a>
      </div>
      <div class="row g-4">
        <div class="col-12 col-lg-8">
          <div class="cd mb-4"><div class="cd-p"><div class="row g-4">
            <div class="col-6 col-md-3"><div class="k">@(T("Subtotal"))</div><div class="num" style="font-size:24px;font-weight:800;letter-spacing:-.025em;margin-top:6px">@(T("SAR")) @(Php.NumberFormat((decimal) invoice.SubtotalAmount))</div><div style="font-size:12.5px;color:var(--muted);margin-top:4px">@(T("Contract value"))</div></div>
            <div class="col-6 col-md-3"><div class="k">@(T("Total to hotel"))</div><div class="num" style="font-size:24px;font-weight:800;letter-spacing:-.025em;margin-top:6px">@(T("SAR")) @(Php.NumberFormat((decimal) invoice.TotalAmount))</div><div style="font-size:12.5px;color:var(--muted);margin-top:4px">@(T("VAT SAR :amount", new Dictionary<string, object?> { ["amount"] = Php.NumberFormat((decimal) invoice.VatAmount, 2) }))</div></div>
            <div class="col-6 col-md-3"><div class="k">@(T("Midad commission"))</div><div class="num" style="font-size:24px;font-weight:800;letter-spacing:-.025em;margin-top:6px">@(T("SAR")) @(Php.NumberFormat((decimal) invoice.CommissionAmount))</div><div style="font-size:12.5px;color:var(--muted);margin-top:4px">@(T("10% of subtotal"))</div></div>
            <div class="col-6 col-md-3"><div class="k">@(T("Your payout"))</div><div class="num" style="font-size:24px;font-weight:800;letter-spacing:-.025em;margin-top:6px;color:var(--olive)">@(T("SAR")) @(Php.NumberFormat(payout))</div><div style="font-size:12.5px;color:var(--muted);margin-top:4px">@(T(Php.InArray(invoice.InvoiceStatus, new[] { "Paid", "Partially Refunded" }, true) ? "Hotel has paid" : "After the hotel pays"))</div></div>
          </div></div></div>
          <div class="cd">
            <div class="cd-h"><div class="cd-t">@(T("Items invoiced"))</div><span style="font-size:14px;color:var(--muted);font-weight:500">@(sr.ItemsSummary())</span></div>
            <div class="md-table-scroll">
            <table class="tb">
              <thead><tr><th>#</th><th>@(T("Product"))</th><th class="text-end">@(T("Quantity"))</th></tr></thead>
              <tbody>
                @foreach (var (s, loop) in Php.Loop(sr.Supplies)) {<text>
                <tr><td class="num" style="color:var(--faint)">@(loop.Iteration)</td><td style="font-weight:700">@(s.SupplyName)</td><td class="text-end num">@(Php.NumberFormat(s.Quantity)) @(s.UnitOfMeasure)</td></tr>
                </text>}
              </tbody>
            </table>
            </div>
          </div>
        </div>
        <div class="col-12 col-lg-4">
          <div class="cd cd-p mb-3">
            <div class="cd-t mb-4">@(T("Amounts"))</div>
            <div class="box">
              <div class="br mb-3"><span style="color:var(--muted)">@(T("Subtotal"))</span><span class="num">@(T("SAR")) @(Php.NumberFormat((decimal) invoice.SubtotalAmount, 2))</span></div>
              <div class="br mb-3"><span style="color:var(--muted)">@(T("VAT at 15%"))</span><span class="num">@(T("SAR")) @(Php.NumberFormat((decimal) invoice.VatAmount, 2))</span></div>
              <div class="br mb-3" style="padding-top:12px;border-top:1px solid var(--line)"><span style="color:var(--muted);font-weight:600">@(T("Total to hotel"))</span><span class="num" style="font-weight:800;font-size:16px">@(T("SAR")) @(Php.NumberFormat((decimal) invoice.TotalAmount, 2))</span></div>
              <div class="br mb-3"><span style="color:var(--muted)">@(T("Midad commission (10%)"))</span><span class="num">− @(T("SAR")) @(Php.NumberFormat((decimal) invoice.CommissionAmount, 2))</span></div>
              <div class="br"><span style="color:var(--muted);font-weight:600">@(T("Your payout"))</span><span class="num" style="font-weight:800">@(T("SAR")) @(Php.NumberFormat(payout, 2))</span></div>
            </div>
          </div>
          <div class="al a-info"><i class="bi bi-info-circle-fill"></i><div><div class="al-t">@(T("How payouts work"))</div><div class="al-b">@(T("The hotel pays the invoice by card. Midad keeps a 10% commission on the subtotal and pays out the rest."))</div></div></div>
        </div>
      </div>
    </div></div>
@* @endsection *@
