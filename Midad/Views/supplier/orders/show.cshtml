
@{
    PurchaseOrder order = Get<PurchaseOrder>("order");
}

@{ Layout = "~/Views/Shared/_LayoutSupplier.cshtml"; }
@{ ViewData["title"] = order.OrderNo; }
@{
var c = order.Contract;
var bid = c.Bid;
var sr = bid.Request;
var inv = order.Invoice;
var step = OrderService.SUPPLIER_STEPS[order.OrderStatus] ?? null;
var late = Php.B(order.ActualDeliveryDate) && Php.B(order.ActualDeliveryDate.Gt(order.ExpectedDeliveryDate));
}

    <div class="body-pad"><div class="wrap">
      <div class="crumb"><a href="@(Route("supplier.orders.index"))" class="md-link" style="color:inherit">@(T("Orders"))</a> <span style="color:var(--faint)">/</span> <b>@(order.OrderNo)</b></div>
      @await Html.PartialAsync("~/Views/Shared/_FlashSite.cshtml", With(new Dictionary<string, object?> {  }))
      <div class="d-flex align-items-start justify-content-between mb-5 flex-wrap" style="gap:24px">
        <div>
          <div class="d-flex align-items-center gap-3 mb-3"><span class="rq-no">@(order.OrderNo)</span>@await Html.PartialAsync("~/Views/Shared/_StatusPill.cshtml", Component(new Dictionary<string, object?> { ["shell"] = "supplier", ["value"] = order.OrderStatus }))</div>
          <h1 class="pg-h1">@(sr.Title)</h1>
          <p class="pg-sub">@(sr.Hotel.HotelName) · @(T("contract :no", new Dictionary<string, object?> { ["no"] = c.ContractNo })) · @(T("created :date", new Dictionary<string, object?> { ["date"] = order.CreatedAt.TranslatedFormat("j M Y") }))</p>
        </div>
        @if (Can("advance", order)) {<text>
        <button class="btn b-olive btn-lg" type="button" data-md-open="#advanceOrder"><i class="bi bi-truck"></i>@(T(step[1]))</button>
        </text>}
      </div>
      <div class="row g-4">
        <div class="col-12 col-lg-8">
          <div class="cd mb-4"><div class="cd-p"><div class="row g-4">
            @foreach (var (s, loop) in Php.Loop(new[] { "Created", "Processing", "Shipped", "Delivered", "Completed" })) {<text>
            @{ var pos = Php.ArraySearch(order.OrderStatus, new[] { "Created", "Processing", "Shipped", "Delivered", "Completed" }, true); }
            @{ var done = pos != false && pos >= loop.Index; }
            <div class="col"><div class="k" style="@(Php.B(done) ? "color:var(--olive)" : "")"><i class="bi @(Php.B(done) ? "bi-check-circle-fill" : "bi-circle") me-1"></i>@(T(s))</div></div>
            </text>}
          </div></div></div>
          <div class="cd">
            <div class="cd-h"><div class="cd-t">@(T("Items to deliver"))</div><span style="font-size:14px;color:var(--muted);font-weight:500">@(sr.ItemsSummary())</span></div>
            <div class="md-table-scroll">
            <table class="tb">
              <thead><tr><th>#</th><th>@(T("Product"))</th><th class="text-end">@(T("Quantity"))</th></tr></thead>
              <tbody>
                @foreach (var (s, loop) in Php.Loop(sr.Supplies)) {<text>
                <tr><td class="num" style="color:var(--faint)">@(loop.Iteration)</td><td><div style="font-weight:700">@(s.SupplyName)</div>@if (Php.B(s.Description)) {<text><div style="font-size:13.5px;color:var(--muted);margin-top:4px">@(s.Description)</div></text>}</td><td class="text-end num">@(Php.NumberFormat(s.Quantity)) @(s.UnitOfMeasure)</td></tr>
                </text>}
              </tbody>
            </table>
            </div>
          </div>
        </div>
        <div class="col-12 col-lg-4">
          <div class="cd cd-p mb-3">
            <div class="cd-t mb-4">@(T("Delivery"))</div>
            <dl class="kv mb-0">
              <dt>@(T("Hotel"))</dt><dd>@(sr.Hotel.HotelName) · @(T(sr.Hotel.City))</dd>
              <dt>@(T("Deliver by"))</dt><dd class="num">@(order.ExpectedDeliveryDate.TranslatedFormat("d M Y"))</dd>
              <dt>@(T("Delivered"))</dt><dd class="num" style="margin-bottom:0;@(Php.B(late) ? "color:var(--warn)" : "")">@(order.ActualDeliveryDate?.TranslatedFormat("d M Y") ?? T("Not yet"))</dd>
            </dl>
          </div>
          @if (Php.B(inv)) {<text>
          <div class="cd cd-p mb-3">
            <div class="cd-t mb-4">@(T("Invoice"))</div>
            <dl class="kv mb-4">
              <dt>@(T("Invoice"))</dt><dd class="num">@(inv.InvoiceNo) @await Html.PartialAsync("~/Views/Shared/_StatusPill.cshtml", Component(new Dictionary<string, object?> { ["shell"] = "supplier", ["value"] = inv.InvoiceStatus, ["class"] = "ms-1" }))</dd>
              <dt>@(T("Total incl. VAT"))</dt><dd class="num" style="margin-bottom:0">@(T("SAR")) @(Php.NumberFormat((decimal) inv.TotalAmount, 2))</dd>
            </dl>
            <a class="btn b-line btn-sm" href="@(Route("supplier.invoices.show", inv))">@(T("Open invoice"))</a>
          </div>
          </text>}
          @if (Php.B(order.Rating)) {<text>
          <div class="al a-ok"><i class="bi bi-star-fill"></i><div><div class="al-t">@(T("Rated :n out of 5", new Dictionary<string, object?> { ["n"] = order.Rating.StarRating }))</div>@if (Php.B(order.Rating.ReviewComment)) {<text><div class="al-b">“@(order.Rating.ReviewComment)”</div></text>}</div></div>
          </text>}
        </div>
      </div>
    </div></div>


@{ Push("modals", @<text>
@if (Can("advance", order)) {<text>
<div class="md-modal" id="advanceOrder" hidden role="dialog" aria-modal="true" aria-labelledby="advanceOrderT">
    <div class="scrim"><form class="mdl" method="POST" action="@(Route("supplier.orders.advance", order))">
      @Html.AntiForgeryToken()
      <div class="mdl-h"><div class="mdl-t" id="advanceOrderT">@(T(step[1]))?</div></div>
      <div class="mdl-b">
        <p style="margin:0 0 20px;">@Html.Raw(T(":hotel sees the new status of :no straight away.", new Dictionary<string, object?> { ["hotel"] = Php.E(sr.Hotel.HotelName), ["no"] = "<b>" + Php.E(order.OrderNo) + "</b>" }))@if (step[0] == "Delivered") {<text> @(T("Today's date is recorded as the delivery date, and the hotel confirms receipt to complete the order."))</text>}</p>
        <div class="box">
          <div class="br mb-3"><span style="color:var(--muted)">@(T("Current status"))</span><span>@(T(order.OrderStatus))</span></div>
          <div class="br"><span style="color:var(--muted)">@(T("New status"))</span><span style="font-weight:700">@(T(step[0]))</span></div>
        </div>
      </div>
      <div class="mdl-f">
        <button class="btn b-line" type="button" data-md-close>@(T("Not now"))</button>
        <button class="btn b-olive" type="submit"><i class="bi bi-truck"></i>@(T(step[1]))</button>
      </div>
    </form></div>
</div>
</text>}
</text>); }
