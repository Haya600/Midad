
@{
    List<PurchaseOrder> orders = Get<List<PurchaseOrder>>("orders");
}

@{ Layout = "~/Views/Shared/_LayoutSupplier.cshtml"; }
@{ ViewData["title"] = "Orders"; }

    <div class="body-pad"><div class="wrap">
      @await Html.PartialAsync("~/Views/Shared/_FlashSite.cshtml", With(new Dictionary<string, object?> {  }))
      <div class="sect-head" style="margin-bottom:32px">
        <div><h1 class="pg-h1">@(T("Orders"))</h1><p class="pg-sub">@(T(orders.Count() == 1 ? ":n purchase order" : ":n purchase orders", new Dictionary<string, object?> { ["n"] = orders.Count() })) · @(T(":n in progress", new Dictionary<string, object?> { ["n"] = orders.WhereNotIn("order_status", new[] { "Completed", "Cancelled" }).Count() }))</p></div>
      </div>
      @if (Php.Any(orders)) { foreach (var o in orders) {<text>
        @{ var r = o.Contract.Bid.Request; }
        @{ var step = OrderService.SUPPLIER_STEPS[o.OrderStatus] ?? null; }
      <article class="@Css(("rq", true), ("rq-feat", (bool) step), ("rq-dim", Php.InArray(o.OrderStatus, new[] { "Completed", "Cancelled" }, true)))">
        @await Html.PartialAsync("~/Views/supplier/partials/thumb.cshtml", With(new Dictionary<string, object?> { ["s"] = r.Supplies.First() }))
        <div class="rq-b">
          <div class="rq-top"><span class="rq-no">@(o.OrderNo)</span><span class="rq-hotel">@(r.Hotel.HotelName) · @(T(r.Hotel.City))</span>@await Html.PartialAsync("~/Views/Shared/_StatusPill.cshtml", Component(new Dictionary<string, object?> { ["shell"] = "supplier", ["value"] = o.OrderStatus }))</div>
          <h3 class="rq-h"><a href="@(Route("supplier.orders.show", o))" class="md-link" style="color:inherit">@(r.Title)</a></h3>
          <div class="rq-s">@(r.CardSummary())</div>
          <div class="rq-f">
            <span class="mt"><i class="bi bi-calendar3"></i>@(T("Deliver by")) <b>@(o.ExpectedDeliveryDate.TranslatedFormat("d M Y"))</b></span>
            @if (Php.B(o.ActualDeliveryDate)) {<text><span class="mt"><i class="bi bi-truck"></i>@(T("Delivered")) <b>@(o.ActualDeliveryDate.TranslatedFormat("d M Y"))</b></span></text>}
            @if (Php.B(o.Invoice)) {<text><span class="mt"><i class="bi bi-receipt"></i>@(T("Invoice")) <b>@(o.Invoice.InvoiceNo)</b></span></text>}
            <span class="rq-cta"><a class="@Css(("btn", true), ("b-olive", (bool) step), ("b-line", ! step))" href="@(Route("supplier.orders.show", o))">@(T(step ? step[1] : "View order"))</a></span>
          </div>
        </div>
      </article>
      </text>} } else {<text>
      <div class="lock">@(T("No orders yet. A purchase order is created when both parties have signed the contract."))</div>
      </text>}
    </div></div>

