@* Source: resources/views/supplier/partials/thumb.blade.php *@
@{
    Supply? s = Get<Supply?>("s");
    string? style = Get<string?>("style");
}
@* .thumb tile (UC2 lines 403/615): the supply photo when there is one (§11), else the category icon. $s = Supply|null, $style = extra inline style *@
@{
    var supply = s as Midad.Models.Supply;
    var cls = supply?.ThumbClass ?? "t-equip";
    var hasImage = !string.IsNullOrEmpty(supply?.ImageSrc);
    // @if(! empty($style) || $s?->image_src) style="{{ $style ?? '' }}@if($s?->image_src);overflow:hidden @endif" @endif
    var styleAttr = !Php.Empty(style) || Php.B(hasImage) ? (string)(style ?? "") + (hasImage ? ";overflow:hidden " : "") : null;
}
<span class="thumb @cls" style="@styleAttr">@if (hasImage) {<img src="@supply!.ImageSrc" alt="@supply.SupplyName" loading="lazy" style="width:100%;height:100%;object-fit:cover">} else {<i class="bi @(supply?.ThumbIcon ?? "bi-cart3")"></i>}</span>
