@* Source: resources/views/supplier/profile.blade.php *@
@{
    string? phone = Get<string?>("phone");
    dynamic profile = ViewBag.profile;
    UserAccount user = Get<UserAccount>("user");
}
@* Supplier: Company profile (§7 - PUB-08 fields inside .cd .cd-p): view / update / close the account. *@
@{ Layout = "~/Views/Shared/_LayoutSupplier.cshtml"; }
@{ ViewData["title"] = "Company profile"; }
@{ var n = Php.Count(Php.ArrayDiff(errors.Keys(), new[] { "phone_local", "confirm_email" })); }
@* @section('content') = the Razor body *@
    <div class="body-pad"><div class="wrap">
      @await Html.PartialAsync("~/Views/Shared/_FlashSite.cshtml", With(new Dictionary<string, object?> {  }))
      <div class="sect-head" style="margin-bottom:32px">
        <div><div class="d-flex align-items-center gap-3 mb-2 flex-wrap"><h1 class="pg-h1">@(profile.CompanyName)</h1>@await Html.PartialAsync("~/Views/Shared/_StatusPill.cshtml", Component(new Dictionary<string, object?> { ["shell"] = "supplier", ["value"] = profile.ProfileStatus }))</div><p class="pg-sub">@(T("Member since :date", new Dictionary<string, object?> { ["date"] = user.CreatedAt.TranslatedFormat("j M Y") })) · <i class="bi bi-star-fill" style="color:var(--warn)"></i> @(Php.NumberFormat((decimal) profile.AvgRating, 1))</p></div>
      </div>
      @if (Php.B(n)) {<text>
      <div class="al a-dang mb-4"><i class="bi bi-exclamation-triangle-fill"></i><div><div class="al-t">@(T("Your profile could not be saved"))</div><div class="al-b">@(MidadRequest.Attention(n, "save again. Everything you entered has been kept."))</div></div></div>
      </text>} else if (profile.ProfileStatus != "Verified") {<text>
      <div class="al a-warn mb-4"><i class="bi bi-exclamation-triangle-fill"></i><div><div class="al-t">@(T("Your registration is being verified"))</div><div class="al-b">@(T("You can browse open supply requests straight away. You will be able to submit bids as soon as your registration is verified."))</div></div></div>
      </text>}
      <div class="row g-4">
        <div class="col-12 col-lg-8">
          <form method="POST" action="@(Route("supplier.profile.update"))">
            @Html.AntiForgeryToken() <input type="hidden" name="_method" value="PUT">
            <div class="cd"><div class="cd-p">
              @await Html.PartialAsync("~/Views/Shared/_ProfileFields.cshtml", With(new Dictionary<string, object?> { ["shell"] = "supplier", ["kind"] = "supplier", ["profile"] = profile, ["user"] = user, ["phone"] = phone }))
            </div></div>
            <div class="actbar">
              <button class="btn b-ghost" type="button" style="color:var(--dang)" data-md-open="#closeAccount"><i class="bi bi-x-circle"></i>@(T("Close account"))</button>
              <button class="btn b-olive btn-lg" type="submit">@(T("Save changes"))</button>
            </div>
          </form>
        </div>
        <div class="col-12 col-lg-4">
          <div class="cd cd-p">
            <div class="cd-t mb-4">@(T("Account"))</div>
            <dl class="kv mb-0">
              <dt>@(T("Profile status"))</dt><dd>@await Html.PartialAsync("~/Views/Shared/_StatusPill.cshtml", Component(new Dictionary<string, object?> { ["shell"] = "supplier", ["value"] = profile.ProfileStatus }))</dd>
              <dt>@(T("Account status"))</dt><dd>@await Html.PartialAsync("~/Views/Shared/_StatusPill.cshtml", Component(new Dictionary<string, object?> { ["shell"] = "supplier", ["value"] = user.AccountStatus }))</dd>
              <dt>@(T("Phone"))</dt><dd class="num">@(MidadPhone.Display(user.Phone))</dd>
              <dt>@(T("Win rate"))</dt><dd class="num" style="margin-bottom:0">@(profile.WinRate())%</dd>
            </dl>
          </div>
        </div>
      </div>
    </div></div>
@* @endsection *@
@{ Push("modals", @<text>
<div class="md-modal" id="closeAccount" hidden role="dialog" aria-modal="true" aria-labelledby="closeAccountT" @Html.Raw((errors.Has("confirm_email")) ? $" data-md-autoshow " : "")>
    <div class="scrim"><form class="mdl" method="POST" action="@(Route("supplier.profile.close"))">
      @Html.AntiForgeryToken()
      <div class="mdl-h"><div class="mdl-t" id="closeAccountT">@(T("Close your Midad account?"))</div></div>
      <div class="mdl-b">
        <p style="margin:0 0 20px;">@(T("You are signed out and can no longer bid. Your contracts, orders and invoices are kept for your records; contact support to reopen the account."))</p>
        @await Html.PartialAsync("~/Views/Shared/_Field.cshtml", Component(new Dictionary<string, object?> { ["shell"] = "supplier", ["name"] = "confirm_email", ["label"] = "Type your email address to confirm", ["type"] = "email", ["placeholder"] = user.Email, ["required"] = true }))
      </div>
      <div class="mdl-f">
        <button class="btn b-line" type="button" data-md-close>@(T("Keep account"))</button>
        <button class="btn b-dang" type="submit">@(T("Close account"))</button>
      </div>
    </form></div>
</div>
</text>); }
