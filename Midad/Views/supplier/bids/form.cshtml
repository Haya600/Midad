
@{
    Bid? bid = Get<Bid?>("bid");
    List<decimal?> copied = Get<List<decimal?>>("copied");
    SupplyRequest sr = Get<SupplyRequest>("sr");
}

@{ Layout = "~/Views/Shared/_LayoutSupplier.cshtml"; }
@{ ViewData["title"] = T(bid ? "Update your bid" : "Create your bid"); }
@{
var due = sr.RequiredDeliveryDate;
var hasErr = errors.Any();
var priceErrs = Php.Collect(errors.Keys()).Filter( (k) => Php.StrStartsWith(k, "unit_prices")).Count();
var termErrs = (errors.Has("bid_price") ? 1 : 0) + (errors.Has("estimated_delivery_days") ? 1 : 0);
var days = Old("estimated_delivery_days", bid?.EstimatedDeliveryDays);
var price = Old("bid_price", bid ? Php.NumberFormat((decimal) bid.BidPrice, 2, ".", "") : null);
var arrival = Php.IsNumeric(days) && days >= 1 && days <= 180 ? Php.Today().AddDays((int) days) : null;
var late = Php.B(arrival) && Php.B(arrival.Gt(due)) ? (int) due.DiffInDays(arrival) : 0;
var warnings = Php.B(late) && Php.B(hasErr) ? 1 : 0;
var fieldErrs = priceErrs + termErrs;
var count = sr.Supplies.Count();
}

    <div class="body-pad"><div class="wrap">
      <div class="crumb">@if (Php.B(bid)) {<text><a href="@(Route("supplier.bids.index"))" class="md-link" style="color:inherit">@(T("My Bids"))</a> <span style="color:var(--faint)">/</span> <a href="@(Route("supplier.bids.show", bid))" class="md-link" style="color:inherit">@(sr.Code)</a> <span style="color:var(--faint)">/</span> <b>@(T("Update bid"))</b></text>} else {<text><a href="@(Route("supplier.requests.index"))" class="md-link" style="color:inherit">@(T("Browse Requests"))</a> <span style="color:var(--faint)">/</span> <a href="@(Route("supplier.requests.show", sr))" class="md-link" style="color:inherit">@(sr.Code)</a> <span style="color:var(--faint)">/</span> <b>@(T("Create bid"))</b></text>}</div>
      <h1 class="pg-h1">@(T(bid ? "Update your bid" : "Create your bid"))</h1>
      <p class="pg-sub" style="margin-bottom:@(Php.B(hasErr) ? 26 : 34)px">@(sr.Code) · @(sr.Hotel.HotelName) · @(T(count == 1 ? ":n item" : ":n items", new Dictionary<string, object?> { ["n"] = count })) · @(T("needed by :date", new Dictionary<string, object?> { ["date"] = due.TranslatedFormat("d M Y") }))</p>

      @if (Php.B(hasErr)) {<text>
      <div class="al a-dang mb-4"><i class="bi bi-exclamation-triangle-fill"></i><div><div class="al-t">@(T(bid ? "This bid could not be updated" : "This bid could not be submitted"))</div><div class="al-b">@(MidadRequest.Attention(fieldErrs, "submit again. Your prices have been kept.", (bool) warnings))</div></div></div>
      </text>}

      <form id="bidForm" method="POST" action="@(Php.B(bid) ? Route("supplier.bids.update", bid) : Route("supplier.bids.store", sr))" data-due="@(due.ToDateString())" data-creating="@(Php.B(bid) ? 0 : 1)">
        @Html.AntiForgeryToken()
        @if (Php.B(bid)) {<text> <input type="hidden" name="_method" value="PUT"> </text>}
      <div class="row g-4">
        <div class="col-12 col-lg-8">
          <div class="cd mb-4">
            <div class="cd-h"><div class="cd-t">@(T("Price per item"))</div>@if (Php.B(priceErrs)) {<text>@await Html.PartialAsync("~/Views/Shared/_StatusPill.cshtml", Component(new Dictionary<string, object?> { ["shell"] = "supplier", ["value"] = "Rejected", ["label"] = T(priceErrs == 1 ? ":n error" : ":n errors", new Dictionary<string, object?> { ["n"] = priceErrs }) }))</text>} else {<text><span style="font-size:14px;color:var(--muted);font-weight:500">@(T("Adds up to your bid price"))</span></text>}</div>
            <div class="cd-p">
              @foreach (var (s, loop) in Php.Loop(sr.Supplies)) {<text>
              @{ var key = "unit_prices." + s.SupplyId; }
              @{ var up = Old(key, copied[loop.Index] ?? null); }
              <div class="@Css(("row g-3 align-items-end", true), ("mb-4", ! loop.Last))" @Html.Raw((!(Php.B(loop.First))) ? $" style=\"padding-top:26px;border-top:1px solid var(--line)\" " : "") data-line data-qty="@(s.Quantity)">
                <div class="col-12 col-md-5"><div style="font-size:15.5px;font-weight:700">@(s.SupplyName)</div><div style="font-size:13.5px;color:var(--muted);margin-top:5px">@(s.ShortSpec)</div></div>
                <div class="col-7 col-md-4"><label class="lbl" for="up@(s.SupplyId)">@(T("Unit price"))</label><div class="ig"><span class="ig-pre">@(T("SAR"))</span><input id="up@(s.SupplyId)" name="unit_prices[@(s.SupplyId)]" type="number" min="0.01" step="0.01" max="99999999.99" inputmode="decimal" placeholder="0.00" value="@(up)" @Html.Raw((!Php.B(bid)) ? $" required " : "") data-up class="@Css(("fld num", true), ("fld-err", errors.Has(key)))"></div>@if (errors.Has(key)) { var message = errors.First(key); <text><div class="emsg"><i class="bi bi-exclamation-circle me-1"></i>@(T(message))</div></text>}</div>
                <div class="col-5 col-md-3"><label class="lbl">@(T("Line total"))</label><div class="fld fld-off num" data-lt>-</div></div>
              </div>
              </text>}
            </div>
          </div>

          <div class="cd">
            <div class="cd-h"><div class="cd-t">@(T("Bid terms"))</div>@if (Php.B(termErrs) || Php.B(warnings)) {<text><div class="d-flex gap-2">@if (Php.B(termErrs)) {<text>@await Html.PartialAsync("~/Views/Shared/_StatusPill.cshtml", Component(new Dictionary<string, object?> { ["shell"] = "supplier", ["value"] = "Rejected", ["label"] = T(termErrs == 1 ? ":n error" : ":n errors", new Dictionary<string, object?> { ["n"] = termErrs }) }))</text>} @if (Php.B(warnings)) {<text>@await Html.PartialAsync("~/Views/Shared/_StatusPill.cshtml", Component(new Dictionary<string, object?> { ["shell"] = "supplier", ["value"] = "Unpaid", ["label"] = "1 warning" }))</text>}</div></text>}</div>
            <div class="cd-p"><div class="row g-3">
              <div class="col-12 col-md-5"><label class="lbl" for="bid_price">@(T("Total bid price")) <span class="star">*</span></label><div class="ig"><span class="ig-pre">@(T("SAR"))</span><input id="bid_price" name="bid_price" type="number" min="0.01" max="9999999999.99" step="0.01" inputmode="decimal" placeholder="0.00" required value="@(price)" data-total class="@Css(("fld num", true), ("fld-err", errors.Has("bid_price")))" style="font-weight:700"></div>@if (errors.Has("bid_price")) { var message = errors.First("bid_price"); <text><div class="emsg"><i class="bi bi-exclamation-circle me-1"></i>@(T(message))</div></text>} else {<text><div class="hint">@(T("Excluding VAT"))</div></text>}</div>
              <div class="col-12 col-md-4"><label class="lbl" for="estimated_delivery_days">@(T("Estimated delivery")) <span class="star">*</span></label><div class="ig"><input id="estimated_delivery_days" name="estimated_delivery_days" type="number" min="1" max="180" step="1" inputmode="numeric" placeholder="0" required value="@(days)" data-days class="@Css(("fld num", true), ("fld-err", errors.Has("estimated_delivery_days")))" @Html.Raw((Php.B(late) && !errors.Has("estimated_delivery_days")) ? $" style=\"border-color:var(--warn)\" " : "")><span class="ig-post">@(T("days"))</span></div>
                @if (errors.Has("estimated_delivery_days")) { var message = errors.First("estimated_delivery_days"); <text><div class="emsg"><i class="bi bi-exclamation-circle me-1"></i>@(T(message))</div></text>} else {<text><div class="hint" data-days-hint @Html.Raw((Php.B(late)) ? $" hidden " : "")>@(T("From contract signature"))</div><div class="wmsg" data-days-warn @Html.Raw((!(Php.B(late))) ? $" hidden " : "")><i class="bi bi-exclamation-triangle me-1"></i>@(T("Later than the hotel's date."))</div></text>}</div>
              <div class="col-12 col-md-3"><label class="lbl">@(T("Expected arrival"))</label><div class="fld fld-off num" data-arrival @Html.Raw((Php.B(late)) ? $" style=\"color:var(--warn)\" " : "")>@(Php.B(arrival) ? arrival.TranslatedFormat("d M Y") : "-")</div><div class="hint" data-arrival-hint>@(T("Calculated"))</div></div>
            </div></div>
          </div>

          <div class="actbar">
            <a class="btn b-ghost" href="@(Php.B(bid) ? Route("supplier.bids.show", bid) : Route("supplier.requests.show", sr))"><i class="bi bi-arrow-left"></i>@(T(bid ? "Back to your bid" : "Back to request"))</a>
            <button class="btn b-off btn-lg" type="button" disabled data-submit><i class="bi bi-hammer"></i>@(T(bid ? "Update bid" : "Submit bid"))</button>
          </div>
        </div>

        <div class="col-12 col-lg-4">
          <div class="cd cd-p mb-3">
            <div class="cd-t mb-4">@(T("Bid summary"))</div>
            <div class="box mb-4">
              <div class="br mb-3"><span style="color:var(--muted)">@(T("Bid price"))</span><span class="num" data-s-price>-</span></div>
              <div class="br mb-3"><span style="color:var(--muted)">@(T("VAT at 15%"))</span><span class="num" data-s-vat>-</span></div>
              <div class="br" style="padding-top:12px;border-top:1px solid var(--line)"><span style="color:var(--muted);font-weight:600">@(T("Total to hotel"))</span><span class="num" data-s-total>-</span></div>
            </div>
            <dl class="kv mb-0">
              <dt>@(T("Required by hotel"))</dt><dd class="num">@(due.TranslatedFormat("d M Y"))</dd>
              <dt>@(T("Your delivery"))</dt><dd class="num" style="margin-bottom:0" data-s-delivery></dd>
            </dl>
          </div>
          <div class="al a-info" data-tip-info @Html.Raw((Php.B(late)) ? $" hidden " : "")><i class="bi bi-lightbulb-fill"></i><div><div class="al-t">@(T("Ranked by price first"))</div><div class="al-b">@(T("The hotel sees the lowest bid at the top, with delivery time as the tie-breaker."))</div></div></div>
          <div class="al a-warn" data-tip-warn @Html.Raw((!(Php.B(late))) ? $" hidden " : "")><i class="bi bi-exclamation-triangle-fill"></i><div><div class="al-t">@(T("Late delivery weakens your bid"))</div><div class="al-b">@(T("You can still submit, but the hotel may reject a bid that misses the required date."))</div></div></div>
        </div>
      </div>
      </form>
    </div></div>


@{ Push("modals", @<text>

<div class="md-modal" id="confirmBid" hidden role="dialog" aria-modal="true" aria-labelledby="confirmBidT">
    <div class="scrim"><div class="mdl">
      <div class="mdl-h"><div class="mdl-t" id="confirmBidT">@(T(bid ? "Update this bid?" : "Submit this bid?"))</div></div>
      <div class="mdl-b">
        <p style="margin:0 0 20px;">@Html.Raw(T("Your bid on :code goes to :hotel straight away.", new Dictionary<string, object?> { ["code"] = "<b>" + Php.E(sr.Code) + "</b>", ["hotel"] = "<b>" + Php.E(sr.Hotel.HotelName) + "</b>" }))</p>
        <div class="box">
          <div class="br mb-3"><span style="color:var(--muted)">@(T("Bid price"))</span><span class="num" style="font-weight:800;font-size:16px" data-c-price></span></div>
          <div class="br mb-3"><span style="color:var(--muted)">@(T("VAT at 15%"))</span><span class="num" data-c-vat></span></div>
          <div class="br mb-3" style="padding-top:12px;border-top:1px solid var(--line)"><span style="color:var(--muted);font-weight:600">@(T("Total to hotel"))</span><span class="num" style="font-weight:800;font-size:16px" data-c-total></span></div>
          <div class="br mb-3"><span style="color:var(--muted)">@(T("Delivery"))</span><span class="num" data-c-delivery></span></div>
          <div class="br"><span style="color:var(--muted)">@(T("Items covered"))</span><span style="font-weight:600">@(sr.ItemsSummary())</span></div>
        </div>
        <p style="margin:20px 0 0;font-size:13.5px;color:var(--muted)">@(T("You can update or cancel this bid at any point before the contract is signed. You may hold only one active bid per request."))</p>
      </div>
      <div class="mdl-f">
        <button class="btn b-line" type="button" data-md-close>@(T("Keep editing"))</button>
        <button class="btn b-olive" type="button" data-confirm><i class="bi bi-hammer"></i>@(T(bid ? "Update bid" : "Submit bid"))</button>
      </div>
    </div></div>
</div>
</text>); }

@{ Push("scripts", @<text>
<script>
(function () {
  var form = document.getElementById('bidForm'), vat = @(Config("midad.vat_rate"));
  var total = form.querySelector('[data-total]'), days = form.querySelector('[data-days]');
  var submit = form.querySelector('[data-submit]'), creating = form.dataset.creating === '1';
  var due = new Date(form.dataset.due + 'T00:00:00');
  var touched = total.value !== '';     
  var months = window.mdT.months;
  function money(n) { return n.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2}); }
  function fmt(d) { return ('0' + d.getDate()).slice(-2) + ' ' + months[d.getMonth()] + ' ' + d.getFullYear(); }
  function q(s) { return document.querySelector(s); }
  function set(el, html, style) { el.innerHTML = html; el.setAttribute('style', style || ''); }

  function update() {
    var sum = 0, allPrices = true;
    form.querySelectorAll('[data-line]').forEach(function (row) {
      var up = parseFloat(row.querySelector('[data-up]').value), lt = row.querySelector('[data-lt]');
      if (up > 0) { var v = up * parseInt(row.dataset.qty, 10); sum += v; lt.textContent = money(v); } else { lt.textContent = '-'; allPrices = false; }
    });
    if (!touched && sum > 0) total.value = sum.toFixed(2);

    var p = parseFloat(total.value), d = parseInt(days.value, 10), okP = p > 0, okD = d >= 1 && d <= 180;
    if (okP) {
      set(q('[data-s-price]'), mdt('SAR :amount', {amount: money(p)}), 'font-weight:600'); set(q('[data-s-vat]'), mdt('SAR :amount', {amount: money(p * vat)}));
      set(q('[data-s-total]'), mdt('SAR :amount', {amount: money(p * (1 + vat))}), 'font-weight:800;font-size:16px');
    } else {
      set(q('[data-s-price]'), @Html.Raw(errors.Has("bid_price") ? "mdt('Not set'), 'color:var(--dang);font-weight:600'" : "'-', 'color:var(--faint)'"));
      set(q('[data-s-vat]'), '-', 'color:var(--faint)'); set(q('[data-s-total]'), '-', 'color:var(--faint)');
    }

    var arr = q('[data-arrival]'), aHint = q('[data-arrival-hint]'), sd = q('[data-s-delivery]');
    var dHint = q('[data-days-hint]'), dWarn = q('[data-days-warn]'), late = 0;
    if (okD) {
      var a = new Date(); a.setHours(0,0,0,0); a.setDate(a.getDate() + d);
      late = Math.round((a - due) / 864e5);
      arr.textContent = fmt(a);
      if (late > 0) {
        arr.style.color = 'var(--warn)'; aHint.className = 'wmsg'; aHint.removeAttribute('style'); aHint.textContent = mdt(late === 1 ? ':n day late' : ':n days late', {n: late});
        set(sd, fmt(a) + ' · ' + mdt(late === 1 ? ':n day late' : ':n days late', {n: late}), 'color:var(--warn);margin-bottom:0');
      } else {
        arr.style.color = ''; aHint.className = 'hint'; aHint.setAttribute('style', 'color:var(--olive);font-weight:600'); aHint.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i>' + mdt('Meets the date');
        set(sd, mdt(':n days · :date', {n: d, date: fmt(a)}), 'margin-bottom:0');
      }
    } else {
      arr.textContent = '-'; arr.style.color = ''; aHint.className = 'hint'; aHint.removeAttribute('style'); aHint.textContent = mdt('Calculated');
      set(sd, mdt('Not set'), 'color:var(--faint);font-weight:500;margin-bottom:0');
    }
    if (dHint) { dHint.hidden = late > 0; dWarn.hidden = !(late > 0); if (!days.classList.contains('fld-err')) days.style.borderColor = late > 0 ? 'var(--warn)' : ''; }
    q('[data-tip-info]').hidden = late > 0; q('[data-tip-warn]').hidden = !(late > 0);

    var ready = Php.B(okP) && Php.B(okD) && (!Php.B(creating) || Php.B(allPrices));
    submit.disabled = !ready; submit.classList.toggle('b-olive', ready); submit.classList.toggle('b-off', !ready);
    return {p: p, d: d, late: late, a: arr.textContent};
  }

  form.addEventListener('input', function (e) {
    if (e.target === total) touched = total.value !== '';
    if (e.target.classList.contains('fld-err')) e.target.classList.remove('fld-err');
    update();
  });
  form.addEventListener('submit', function (e) { e.preventDefault(); submit.click(); });
  submit.addEventListener('click', function () {
    if (!form.reportValidity()) return;
    var s = update();
    q('[data-c-price]').textContent = mdt('SAR :amount', {amount: money(s.p)}); q('[data-c-vat]').textContent = mdt('SAR :amount', {amount: money(s.p * vat)});
    q('[data-c-total]').textContent = mdt('SAR :amount', {amount: money(s.p * (1 + vat))});
    var c = q('[data-c-delivery]'); c.textContent = mdt(s.late > 0 ? ':n days · by :date (:late days late)' : ':n days · by :date', {n: s.d, date: s.a, late: s.late});
    c.style.color = s.late > 0 ? 'var(--warn)' : '';
    mdModal(document.getElementById('confirmBid'), true);
  });
  q('[data-confirm]').addEventListener('click', function () { this.disabled = true; HTMLFormElement.prototype.submit.call(form); });
  update();
})();
</script>
</text>); }
