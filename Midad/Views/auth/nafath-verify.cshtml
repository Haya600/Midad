
@{
    long left = Get<long>("left");
    int n = Get<int>("n");
}

@{ Layout = "~/Views/auth/card.cshtml"; }
@{ ViewData["title"] = "Continue with Nafath"; }
@section card {<text>
      <h1 class="text-center">@(T("Open the Nafath app"))</h1>
      <p class="sub text-center">@(T("Choose this number in the Nafath app to confirm it is you (ID :id).", new Dictionary<string, object?> { ["id"] = n["id"] }))</p>
      <div class="text-center mb-4">
        <div class="num" style="display:inline-flex;align-items:center;justify-content:center;width:120px;height:120px;border-radius:var(--r-xl);background:var(--olive);color:#fff;font-size:52px;font-weight:800;letter-spacing:-.02em;box-shadow:var(--sh-2)" aria-label="@(T("Verification number"))">@(n["code"])</div>
        <div class="mt-3" style="font-size:14px;color:var(--muted)" data-nafath-timer data-left="@(left)">@(T("The request expires in :s seconds.", new Dictionary<string, object?> { ["s"] = left }))</div>
      </div>
      <div class="al a-info mb-4"><i class="bi bi-info-circle-fill"></i><div><div class="al-t">@(T("Simulation"))</div><div class="al-b">@(T("In the real service you approve this in the Nafath app on your phone. Here, use the button below."))</div></div></div>
      <form method="POST" action="@(Route("login.nafath.approve"))" data-nafath-approve>
        @Html.AntiForgeryToken()
        <button class="btn b-olive btn-lg b-full" type="submit" @Html.Raw((left == 0) ? "disabled" : "")><i class="bi bi-check2-circle"></i>@(T("Approve in Nafath (simulation)"))</button>
      </form>
      <form method="POST" action="@(Route("login.nafath.cancel"))" class="mt-3">
        @Html.AntiForgeryToken()
        <button class="btn b-line btn-lg b-full" type="submit">@(T("Cancel"))</button>
      </form>
</text>}
@{ Push("scripts", @<text>
<script>
(function () {
  var t = document.querySelector('[data-nafath-timer]'), left = parseInt(t.dataset.left, 10);
  var tpl = @Html.Raw(Php.JsonEncode(T("The request expires in :s seconds."))), expired = @Html.Raw(Php.JsonEncode(T("The Nafath request expired. Start again.")));
  var btn = document.querySelector('[data-nafath-approve] button');
  var timer = setInterval(function () {
    left -= 1;
    if (left <= 0) { clearInterval(timer); t.textContent = expired; t.style.color = 'var(--dang)'; btn.disabled = true; btn.classList.replace('b-olive', 'b-off'); return; }
    t.textContent = tpl.replace(':s', left);
  }, 1000);
})();
</script>
</text>); }
