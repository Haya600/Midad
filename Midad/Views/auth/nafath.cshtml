@* Source: resources/views/auth/nafath.blade.php *@
@* Nafath sign-in, step 1 (SIMULATION) - same centred card as Log in. *@
@{ Layout = "~/Views/auth/card.cshtml"; }
@{ ViewData["title"] = "Continue with Nafath"; }
@section card {<text>
      <div class="text-center mb-4">
        <span style="width:64px;height:64px;border-radius:18px;background:var(--olive-tint);color:var(--olive);display:inline-flex;align-items:center;justify-content:center;font-size:30px"><i class="bi bi-shield-check"></i></span>
      </div>
      <h1 class="text-center">@(T("Continue with Nafath"))</h1>
      <p class="sub text-center">@(T("Sign in with your national digital identity."))</p>
      <div class="al a-info mb-4"><i class="bi bi-info-circle-fill"></i><div><div class="al-t">@(T("Simulation"))</div><div class="al-b">@(T("This is a demonstration of the Nafath sign-in. No request is sent to Nafath and no national data is stored."))</div></div></div>
      <form method="POST" action="@(Route("login.nafath.start"))">
        @Html.AntiForgeryToken()
        @await Html.PartialAsync("~/Views/Shared/_Field.cshtml", Component(new Dictionary<string, object?> { ["col"] = "fgrp", ["name"] = "national_id", ["label"] = "National ID / Iqama number", ["placeholder"] = "1XXXXXXXXX", ["hint"] = "10 digits, starting with 1 (citizen) or 2 (resident)", ["required"] = true, ["inputmode"] = "numeric", ["minlength"] = "10", ["maxlength"] = "10", ["pattern"] = "^[12][0-9]{9}$", ["title"] = "10 digits", ["autocomplete"] = "off", ["autofocus"] = true }))
        @await Html.PartialAsync("~/Views/Shared/_Field.cshtml", Component(new Dictionary<string, object?> { ["col"] = "fgrp", ["name"] = "email", ["label"] = "Midad account email", ["type"] = "email", ["placeholder"] = $"{Php.E(T("you@company.com"))}", ["hint"] = "The account you want to sign in to", ["required"] = true, ["autocomplete"] = "email" }))
        <button class="btn b-olive btn-lg b-full" type="submit"><i class="bi bi-shield-check"></i>@(T("Send request to Nafath"))</button>
      </form>
      <div class="text-center mt-4"><a href="@(Route("login"))" class="md-link" style="font-size:14px;color:var(--olive);font-weight:600"><i class="bi bi-arrow-left me-1"></i>@(T("Back to log in"))</a></div>
</text>}
