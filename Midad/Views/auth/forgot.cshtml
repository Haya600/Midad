

@{ Layout = "~/Views/auth/card.cshtml"; }
@{ ViewData["title"] = "Forgot password"; }
@section card {<text>
      <h1>@(T("Forgot password"))</h1>
      <p class="sub">@(T("Remembered it?")) <a href="@(Route("login"))" class="md-link" style="color:var(--olive);font-weight:600">@(T("Log in"))</a></p>
      @if (Php.B(Session("status"))) {<text>
      <div class="al a-ok mb-4"><i class="bi bi-check-circle-fill"></i><div><div class="al-t">@(T("Check your email"))</div><div class="al-b">@(T(Session("status")))</div></div></div>
      </text>}
      <form method="POST" action="@(Route("password.email"))">
        @Html.AntiForgeryToken()
        @await Html.PartialAsync("~/Views/Shared/_Field.cshtml", Component(new Dictionary<string, object?> { ["col"] = "fgrp", ["name"] = "email", ["label"] = "Email address", ["type"] = "email", ["placeholder"] = $"{Php.E(T("you@company.com"))}", ["hint"] = "We send a link to reset the password. It works for 60 minutes.", ["star"] = false, ["required"] = true, ["autocomplete"] = "email", ["autofocus"] = true }))
        <button class="btn b-olive btn-lg b-full" type="submit">@(T("Send reset link"))</button>
      </form>
</text>}
