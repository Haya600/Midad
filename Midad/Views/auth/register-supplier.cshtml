@* Source: resources/views/auth/register-supplier.blade.php *@
@{
    string[] categories = Get<string[]>("categories");
}
@* PUB-08 Register a supplier (lines 630-670); PUB-09 error state (lines 687-717). *@
@{ Layout = "~/Views/Shared/_LayoutPublic.cshtml"; ViewData["nav"] = "suppliers"; }
@{ ViewData["title"] = "Register a supplier"; }
@* @section('content') = the Razor body *@
    @{ var picked = Old("supply_categories", new List<object?>()); }
    <section class="sect s-cream"><div class="wrap" style="max-width:820px">
      @await Html.PartialAsync("~/Views/auth/partials/register-head.cshtml", With(new Dictionary<string, object?> { ["step"] = 2 }))
      @if (errors.Any()) {<text>
      <div class="ctr" style="margin-bottom:26px"><h2 style="font-size:36px">@(T("Tell us about your business"))</h2></div>
      @await Html.PartialAsync("~/Views/auth/partials/register-summary.cshtml", With(new Dictionary<string, object?> {  }))
      </text>} else {<text>
      <div class="ctr" style="margin-bottom:32px"><h2 style="font-size:36px">@(T("Tell us about your business"))</h2><p class="sect-sub">@(T("Your categories decide which supply requests we show you."))</p></div>
      </text>}

      <form method="POST" action="@(Route("register.supplier.store"))" class="cd" data-register><div class="cd-p">
        @Html.AntiForgeryToken()
        <div class="cd-t mb-4">@(T("Supplier details"))</div>
        <div class="row g-3">
          @await Html.PartialAsync("~/Views/Shared/_Field.cshtml", Component(new Dictionary<string, object?> { ["col"] = "col-12 col-md-8 fgrp", ["name"] = "company_name", ["label"] = "Company name", ["placeholder"] = $"{Php.E(T("e.g. Al Jazeera Hotel Supplies"))}", ["required"] = true, ["maxlength"] = "120", ["autocomplete"] = "organization", ["data-ok"] = true }))
          @await Html.PartialAsync("~/Views/Shared/_Field.cshtml", Component(new Dictionary<string, object?> { ["col"] = "col-12 col-md-4 fgrp", ["name"] = "city", ["label"] = "City", ["type"] = "select", ["placeholder"] = $"{Php.E(T("Select city"))}", ["options"] = Config("midad.cities"), ["required"] = true, ["data-ok"] = true }))
          @await Html.PartialAsync("~/Views/Shared/_Field.cshtml", Component(new Dictionary<string, object?> { ["col"] = "col-12 col-md-6 fgrp", ["name"] = "commercial_reg_no", ["label"] = "Commercial registration no.", ["placeholder"] = $"{Php.E(T("10 digits"))}", ["required"] = true, ["inputmode"] = "numeric", ["minlength"] = "10", ["maxlength"] = "10", ["pattern"] = "^[0-9]{10}$", ["title"] = $"{Php.E(T("10 digits"))}", ["data-ok"] = true, ["data-cr"] = true }))
          @await Html.PartialAsync("~/Views/Shared/_Field.cshtml", Component(new Dictionary<string, object?> { ["col"] = "col-12 col-md-6 fgrp", ["name"] = "contact_person", ["label"] = "Contact person", ["placeholder"] = $"{Php.E(T("Full name"))}", ["required"] = true, ["maxlength"] = "100", ["autocomplete"] = "name", ["data-ok"] = true }))
          <div class="col-12 fgrp"><label class="lbl">@(T("Supply categories")) <span class="star">*</span></label>
            <div class="d-flex gap-2 flex-wrap" style="padding-top:4px">
              @foreach (var cat in categories) {<text>
              @{ var on = Php.InArray(cat, picked, true); }
              <label class="@Css(("btn btn-sm md-chip", true), ("b-olive", on), ("b-line", ! on))" @Html.Raw((Php.B(on)) ? $" style=\"box-shadow:none\" " : "")><input type="checkbox" class="md-hide" name="supply_categories[]" value="@(cat)" @Html.Raw((on) ? "checked" : "")><i class="bi bi-check2"></i>@(cat)</label>
              </text>}
            </div>
            @if (errors.Has("supply_categories")) { var message = errors.First("supply_categories"); <text><div class="emsg"><i class="bi bi-exclamation-circle me-1"></i>@(T(message))</div></text>} else {<text><div class="hint">@(T("You will be shown requests in these categories first."))</div></text>}
          </div>
        </div>
        @await Html.PartialAsync("~/Views/auth/partials/account-fields.cshtml", With(new Dictionary<string, object?> { ["emailPh"] = "you@company.com", ["emailHint"] = null, ["submit"] = "Create supplier account" }))
      </div></form>
    </div></section>
@* @endsection *@
@{ Push("scripts", @<text>@await Html.PartialAsync("~/Views/auth/partials/register-js.cshtml", With(new Dictionary<string, object?> {  }))</text>); }
