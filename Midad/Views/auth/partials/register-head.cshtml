
@{
    int step = Get<int>("step");
}

@section hdr_r {<text><span style="font-size:14.5px;color:var(--muted)">@(T("Already registered?"))</span><a class="btn b-line" href="@(Route("login"))">@(T("Log in"))</a></text>}
      <div class="step-dots" style="justify-content:center">
        @if (step == 1) {<text>
        <span class="dot on"><b>1</b>@(T("Account type"))</span><i class="bi bi-chevron-right" style="color:var(--faint);font-size:12px"></i>
        </text>} else {<text>
        <span class="dot done"><b><i class="bi bi-check2"></i></b>@(T("Account type"))</span><i class="bi bi-chevron-right" style="color:var(--faint);font-size:12px"></i>
        </text>}
        <span class="@Css(("dot", true), ("on", step == 2))"><b>2</b>@(T("Business details"))</span><i class="bi bi-chevron-right" style="color:var(--faint);font-size:12px"></i>
        <span class="dot"><b>3</b>@(T("Verification"))</span>
      </div>
