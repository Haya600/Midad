@* Source: resources/views/public/home.blade.php *@
@{
    string? awarded = Get<string?>("awarded");
    int hotels = Get<int>("hotels");
    string? postUrl = Get<string?>("postUrl");
    int suppliers = Get<int>("suppliers");
}
@* PUB-01 Home - UI/04-public-pages.html lines 228-349 (header/footer from the layout). *@
@{ Layout = "~/Views/Shared/_LayoutPublic.cshtml"; ViewData["nav"] = "home"; ViewData["footer"] = "full"; }
@{ ViewData["title"] = "Hotel supplies, sourced in one place"; }
@* @section('content') = the Razor body *@
    <section class="hero"><div class="wrap hero-in">
      <div class="hero-l">
        <span class="eyebrow"><i class="bi bi-buildings"></i>@(T("Hotels & suppliers · Saudi Arabia"))</span>
        <h1>@(T("Hotel supplies,"))<br>@(T("sourced in")) <em>@(T("one place"))</em>.</h1>
        <p class="hero-p">@(T("Hotels post what they need: towels, bedsheets, amenities. Suppliers compete on price and delivery. You compare every bid side by side and sign the contract in the platform."))</p>
        <div class="hero-cta">
          <a class="btn b-olive btn-xl" href="@(postUrl)">@(T("Post a supply request"))</a>
          <a class="btn b-line btn-xl" href="@(Route("supplier.home"))">@(T("Browse as a supplier"))</a>
        </div>
        <div class="trust">
          <div><div class="n">@(Php.NumberFormat(hotels))</div><div class="l">@(T("Hotels registered"))</div></div>
          <div><div class="n">@(Php.NumberFormat(suppliers))</div><div class="l">@(T("Suppliers bidding"))</div></div>
          <div><div class="n">@(awarded)</div><div class="l">@(T("Contracts awarded"))</div></div>
        </div>
      </div>

      <div class="hero-r">
        @await Html.PartialAsync("~/Views/svg/hero-public.cshtml", With(new Dictionary<string, object?> {  }))
      </div>
    </div></section>

    <section class="sect s-white"><div class="wrap">
      <div class="ctr"><span class="kicker">@(T("The problem"))</span><h2>@(T("Sourcing supplies by phone and email costs hotels time and money"))</h2>
        <p class="sect-sub">@(T("Hotels contact suppliers one by one, with no easy way to compare prices or specifications. Suppliers struggle to reach hotels at all. Midad puts both sides in one place."))</p></div>
      <div class="row g-4">
        <div class="col-12 col-sm-6 col-lg-4"><div class="step"><span class="step-n">1</span><h3>@(T("Post what you need"))</h3><p>@(T("The hotel enters the product, quantity, specifications and the date it must arrive. One request reaches every registered supplier."))</p></div></div>
        <div class="col-12 col-sm-6 col-lg-4"><div class="step"><span class="step-n">2</span><h3>@(T("Compare every bid"))</h3><p>@(T("Suppliers bid on price and delivery time. Midad ranks them with the best bid at the top, so the comparison takes seconds."))</p></div></div>
        <div class="col-12 col-sm-6 col-lg-4"><div class="step"><span class="step-n">3</span><h3>@(T("Sign and track"))</h3><p>@(T("Accept a bid and the contract is generated for both parties to sign digitally. The order, invoice and payment follow in the platform."))</p></div></div>
      </div>
    </div></section>

    <section class="sect s-cream"><div class="wrap">
      <div class="ctr"><span class="kicker">@(T("What hotels source"))</span><h2>@(T("Every guest-facing supply, in one marketplace"))</h2></div>
      <div class="row g-3">
        <div class="col-6 col-md-4 col-lg"><div class="cat"><span class="cat-i" style="background:#EDEFE4;color:#5A6B33"><i class="bi bi-hospital"></i></span><h4>@(T("Bedsheets"))</h4><p>@(T("Linen & bedding"))</p></div></div>
        <div class="col-6 col-md-4 col-lg"><div class="cat"><span class="cat-i" style="background:#E6F0EB;color:#2F6B54"><i class="bi bi-moisture"></i></span><h4>@(T("Towels"))</h4><p>@(T("Bath & pool"))</p></div></div>
        <div class="col-6 col-md-4 col-lg"><div class="cat"><span class="cat-i" style="background:#F1EBE2;color:#8A6E4B"><i class="bi bi-slash-square"></i></span><h4>@(T("Slippers"))</h4><p>@(T("Guest amenities"))</p></div></div>
        <div class="col-6 col-md-4 col-lg"><div class="cat"><span class="cat-i" style="background:#EDE9F0;color:#6D5B7A"><i class="bi bi-droplet"></i></span><h4>@(T("Shampoo"))</h4><p>@(T("Bath amenities"))</p></div></div>
        <div class="col-6 col-md-4 col-lg"><div class="cat"><span class="cat-i" style="background:#E7EDF0;color:#4A6474"><i class="bi bi-box2"></i></span><h4>@(T("Soap"))</h4><p>@(T("Bath amenities"))</p></div></div>
        <div class="col-6 col-md-4 col-lg"><div class="cat"><span class="cat-i" style="background:#F0EAE4;color:#7A6E5E"><i class="bi bi-bag-check"></i></span><h4>@(T("Toothbrush kits"))</h4><p>@(T("Guest amenities"))</p></div></div>
      </div>
    </div></section>

    <section class="sect s-white"><div class="wrap"><div class="row g-4">
      <div class="col-12 col-lg-6"><div class="split">
        <span class="pick-i"><i class="bi bi-buildings"></i></span>
        <h3>@(T("For hotels"))</h3>
        <p>@(T("Stop calling suppliers one by one. Post once and let them compete for your order."))</p>
        <ul>
          <li><i class="bi bi-check-circle-fill"></i>@(T("Reduce purchasing costs through competitive bids"))</li>
          <li><i class="bi bi-check-circle-fill"></i>@(T("Compare price, delivery time and supplier rating in one view"))</li>
          <li><i class="bi bi-check-circle-fill"></i>@(T("Contracts, invoices and payments stored in one place"))</li>
          <li><i class="bi bi-check-circle-fill"></i>@(T("Request refunds for damaged orders and track the status"))</li>
        </ul>
        <a class="btn b-taupe btn-lg mt-4" href="@(Route("register.hotel"))">@(T("Register as a hotel"))</a>
      </div></div>
      <div class="col-12 col-lg-6"><div class="split olive">
        <span class="pick-i" style="background:var(--olive);color:#fff"><i class="bi bi-truck"></i></span>
        <h3>@(T("For suppliers"))</h3>
        <p>@(T("Reach hotels that are actively buying, with the specifications stated up front."))</p>
        <ul>
          <li><i class="bi bi-check-circle-fill"></i>@(T("New business opportunities without cold outreach"))</li>
          <li><i class="bi bi-check-circle-fill"></i>@(T("Full specifications before you price, no revised quotes"))</li>
          <li><i class="bi bi-check-circle-fill"></i>@(T("Transparent ranking: price first, delivery time second"))</li>
          <li><i class="bi bi-check-circle-fill"></i>@(T("Ratings that follow you to every request you bid on"))</li>
        </ul>
        <a class="btn b-olive btn-lg mt-4" href="@(Route("register.supplier"))">@(T("Register as a supplier"))</a>
      </div></div>
    </div></div></section>

    <section class="sect s-cream" style="padding-top:0"><div class="wrap">
      <div class="cta">
        <div><h2>@(T("Ready to source smarter?"))</h2><p>@(T("Create a free account and post your first supply request in minutes."))</p></div>
        <a class="btn b-white btn-xl" href="@(Route("register"))" style="flex:none">@(T("Create your account"))</a>
      </div>
    </div></section>
@* @endsection *@
