

@if (Php.B(f = Session("flash"))) {<text>
  @{ var (tone, title, body) = f + new[] { null, null, null }; }
      <div class="al a-@(tone) mb-4"><i class="bi @(new Dictionary<string, object ? > { ["ok"] = "bi-check-circle-fill", ["dang"] = "bi-exclamation-triangle-fill", ["warn"] = "bi-exclamation-triangle-fill", ["info"] = "bi-info-circle-fill" }[tone] ?? "bi-info-circle-fill")"></i><div><div class="al-t">@(T(title))</div>@if (Php.B(body)) {<text><div class="al-b">@(T(body))</div></text>}</div></div>
</text>}
