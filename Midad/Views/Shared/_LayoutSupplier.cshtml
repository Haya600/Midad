@* Source: resources/views/layouts/supplier.blade.php *@
@{
    string? footer = Get<string?>("footer");
    string? label = Get<string?>("label");
    dynamic match = ViewBag.match;
    string? md_active = Get<string?>("md_active");
    Shell.Who? md_user = Get<Shell.Who?>("md_user");
    string? route = Get<string?>("route");
}
@*
  Supplier shell - md-supplier.css. Markup: UI/03-uc2-supplier-create-bid.html header (lines 285-291), footer (468-480).
  @extends('layouts.supplier', ['footer' => true])   footer = UC2-01 only
  Active nav item comes from the route name; UC2-01..07 and UC2-10 show "Browse Requests", UC2-08/09 "My Bids".
*@
<!DOCTYPE html>
<html lang="@(Locale())" dir="@(Locale() == "ar" ? "rtl" : "ltr")">
<head>
@await Html.PartialAsync("~/Views/Shared/_Head.cshtml", With(new Dictionary<string, object?> { ["sheet"] = "md-supplier" }))
</head>
<body class="md-drawer-nav">@* supplier: nav links live in the left drawer at every width (client request) *@
@{ var md = md_user ?? (Auth().User?.Role == "Supplier" ? Shell.User() : null); }
@* $S = \App\Support\Shell::class - alias of the static Shell class; calls below use Shell.Url directly *@
    <header class="hdr"><div class="hdr-in">
      <a href="@(Php.B(md) ? Shell.Url("supplier.home") : Route("home"))" class="brand text-reset text-decoration-none">@await Html.PartialAsync("~/Views/svg/logo-header.cshtml", With(new Dictionary<string, object?> {  }))<span class="brand-n">@(T("Midad"))</span></a>
      <nav class="nav" id="mdNav"><div class="md-drawer-h"><span class="brand">@await Html.PartialAsync("~/Views/svg/logo-header.cshtml", With(new Dictionary<string, object?> {  }))<span class="brand-n">@(T("Midad"))</span></span><button type="button" class="md-burger" data-md-toggle aria-label="@(T("Close menu"))"><i class="bi bi-x-lg"></i></button></div>@foreach (var $route, $match, $label] in new[] { new[] { "supplier.requests.index", new[] { "supplier.home", "supplier.requests.*" }, "Browse Requests" }, new[] { "supplier.bids.index", new[] { "supplier.bids.*" }, "My Bids" }, new[] { "supplier.contracts.index", new[] { "supplier.contracts.*" }, "Contracts" }, new[] { "supplier.orders.index", new[] { "supplier.orders.*" }, "Orders" }, new[] { "supplier.invoices.index", new[] { "supplier.invoices.*" }, "Invoices" } }) {<text><a href="@(Shell.Url(route))" class="@Css(("on", Req().RouteIs(...match) || (md_active ?? null) == route))">@(T(label))</a></text>}
      @if (Php.B(md)) {<text><a href="@(Shell.Url("supplier.ratings.index"))" class="@Css(("md-nav-sub", true), ("on", Req().RouteIs("supplier.ratings.*")))">@(T("Ratings"))</a><a href="@(Shell.Url("supplier.profile.edit"))" class="@Css(("md-nav-sub", true), ("on", Req().RouteIs("supplier.profile.*")))">@(T("Company profile"))</a></text>}<a href="@(Route("lang.switch", Locale() == "ar" ? "en" : "ar"))" class="md-nav-sub" lang="@(Locale() == "ar" ? "en" : "ar")">@(Locale() == "ar" ? "English" : "العربية")</a></nav>
      <div class="hdr-r">
        <button type="button" class="md-burger" data-md-toggle aria-label="@(T("Menu"))" aria-expanded="false"><i class="bi bi-list"></i></button>
        @if (Php.B(md)) {<text>
        @await Html.PartialAsync("~/Views/Shared/_Bell.cshtml", With(new Dictionary<string, object?> { ["shell"] = "supplier" }))
        <div class="acct md-acct" data-md-acct role="button" tabindex="0" aria-haspopup="true"><span class="av">@(md["initials"])</span><div style="font-size:13.5px;line-height:1.35"><div style="font-weight:700">@(md["name"])</div><div style="color:var(--muted);font-size:12.5px">@(md["org"])</div></div><i class="bi bi-chevron-down" style="color:var(--muted);font-size:12px"></i>
          <div class="md-acct-menu">
            <a href="@(Shell.Url("supplier.profile.edit"))"><i class="bi bi-building me-2"></i>@(T("Company profile"))</a>
            <a href="@(Shell.Url("supplier.ratings.index"))"><i class="bi bi-star me-2"></i>@(T("Ratings"))</a>
            <a href="@(Route("lang.switch", Locale() == "ar" ? "en" : "ar"))"  lang="@(Locale() == "ar" ? "en" : "ar")"><i class="bi bi-translate me-2"></i>@(Locale() == "ar" ? "English" : "العربية")</a>
            <form method="POST" action="@(Shell.Url("logout"))" class="m-0">@Html.AntiForgeryToken()<button type="submit"><i class="bi bi-box-arrow-right me-2"></i>@(T("Log out"))</button></form>
          </div>
        </div>
        </text>} else if (Auth().Check()) {<text>
        <a class="btn b-olive" href="@(RouteServiceProvider.HomeFor(Auth().User))">@(T("Go to dashboard"))</a>
        </text>} else {<text>
        <a class="btn b-ghost" href="@(Shell.Url("login"))">@(T("Log in"))</a><a class="btn b-olive" href="@(Shell.Url("register.supplier"))">@(T("Create account"))</a>
        </text>}
      </div>
    </div></header>
    <div class="md-backdrop"></div>
@if (!(Req().RouteIs("supplier.home"))) {<text>
    @{ var prev = UrlTo().Previous(); }
    @* client request: a way back / home on every supplier page *@
    <div class="wrap md-backbar">
      <a href="@(Php.B(prev) && prev != UrlTo().Current() && Php.StrStartsWith(prev, UrlTo("/")) ? prev : Shell.Url("supplier.home"))" class="md-link" data-md-back><i class="bi bi-arrow-left me-1"></i>@(T("Back"))</a>
      <span aria-hidden="true">·</span>
      <a href="@(Shell.Url("supplier.home"))" class="md-link"><i class="bi bi-house me-1"></i>@(T("Home"))</a>
    </div>
</text>}

@RenderBody()

@if (footer ?? false) {<text>
    <footer class="ftr"><div class="wrap">
      <div class="ftr-g">
        <div class="ftr-b">
          <div class="brand">@await Html.PartialAsync("~/Views/svg/logo-footer.cshtml", With(new Dictionary<string, object?> {  }))<span class="brand-n">@(T("Midad"))</span></div>
          <p>@(T("The supply procurement marketplace connecting hotels and suppliers across Saudi Arabia."))</p>
        </div>
        <div class="ftr-c"><h4>@(T("For Suppliers"))</h4><a href="@(Shell.Url("supplier.requests.index"))">@(T("Browse requests"))</a><a href="@(Shell.Url("how"))">@(T("How bidding works"))</a><a href="@(Shell.Url("supplier.bids.index"))">@(T("My bids"))</a><a href="@(Shell.Url("supplier.ratings.index"))">@(T("Ratings"))</a></div>
        <div class="ftr-c"><h4>@(T("For Hotels"))</h4><a href="@(Shell.Url("hotel.requests.create"))">@(T("Post a request"))</a><a href="@(Shell.Url("hotel.bids.index"))">@(T("Compare bids"))</a><a href="@(Shell.Url("hotel.contracts.index"))">@(T("Contracts"))</a></div>
        <div class="ftr-c"><h4>@(T("Company"))</h4><a href="#">@(T("About Midad"))</a><a href="@(Shell.Url("contact"))">@(T("Contact us"))</a><a href="#">@(T("Help centre"))</a></div>
      </div>
      <div class="ftr-bar"><span>@(T("© 2026 Midad · Jubail Industrial College"))</span><span>@(T("Privacy · Terms · VAT compliant"))</span></div>
    </div></footer>
</text>}

@Stack("modals")
@await Html.PartialAsync("~/Views/Shared/_Scripts.cshtml", With(new Dictionary<string, object?> {  }))
<script>
// "Back" uses the browser history when the previous page is on this site
document.addEventListener('click', function (e) {
  var b = e.target.closest('[data-md-back]');
  if (b && history.length > 1 && document.referrer.indexOf(location.origin) === 0) { e.preventDefault(); history.back(); }
});
</script>
</body>
</html>
