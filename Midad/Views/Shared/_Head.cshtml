@* Source: resources/views/layouts/partials/head.blade.php *@
@{
    string? sheet = Get<string?>("sheet");
}
@* Shared <head> (blueprint §0): Bootstrap first, then ONE shell stylesheet, then md-responsive.css last. *@
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="csrf-token" content="@(CsrfToken())">
<title>@if (IsSectionDefined("title") || ViewData["title"] != null) {<text>@(T(System.Net.WebUtility.HtmlDecode((ViewData["title"]?.ToString() ?? YieldContent("title")).Trim()))) · @(T("Midad"))</text>} else {<text>@(T("Midad"))</text>}</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
@if (Locale() == "ar") {<text>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
</text>} else {<text>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</text>}
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
<link href="@(Asset("css/" + sheet + ".css"))" rel="stylesheet">
@if (Locale() == "ar") {<text>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link href="@(Asset("css/md-rtl.css"))" rel="stylesheet">
</text>}
@await Html.PartialAsync("~/Views/Shared/_ShellStates.cshtml", With(new Dictionary<string, object?> { ["sheet"] = sheet }))
<link href="@(Asset("css/md-responsive.css"))" rel="stylesheet">
@Stack("head")
