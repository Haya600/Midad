@* Source: resources/views/layouts/public.blade.php *@
@{
    bool bare = Get<bool>("bare");
    string? footer = Get<string?>("footer");
}
@*
  Public shell - md-public.css. Markup: UI/04-public-pages.html header (lines 222-226), footer (351-363).
  @extends('layouts.public', ['nav' => 'home|how|contact|hotels|suppliers', 'footer' => 'full|short', 'bare' => true])
    bare   = no header (PUB-04/05 auth split fills the frame)
    @section('hdr_r') replaces the right side of the header (PUB-06..10)
    footer = 'full' on PUB-01, 'short' on PUB-10 (lines 759-771: no Pricing, no VAT compliance)
*@
<!DOCTYPE html>
<html lang="@(Locale())" dir="@(Locale() == "ar" ? "rtl" : "ltr")">
<head>
@await Html.PartialAsync("~/Views/Shared/_Head.cshtml", With(new Dictionary<string, object?> { ["sheet"] = "md-public" }))
</head>
<body>
@{ var nav = ViewBag.nav ?? null; }
@if (!(bare ?? false)) {<text>
    <header class="hdr"><div class="hdr-in">
      <a href="@(Route("home"))" class="brand text-reset text-decoration-none">@await Html.PartialAsync("~/Views/svg/logo-header.cshtml", With(new Dictionary<string, object?> {  }))<span class="brand-n">@(T("Midad"))</span></a>
      <nav class="nav" id="mdNav"><div class="md-drawer-h"><span class="brand">@await Html.PartialAsync("~/Views/svg/logo-header.cshtml", With(new Dictionary<string, object?> {  }))<span class="brand-n">@(T("Midad"))</span></span><button type="button" class="md-burger" data-md-toggle aria-label="@(T("Close menu"))"><i class="bi bi-x-lg"></i></button></div><a href="@(Route("home"))" class="@Css(("on", nav == "home"))">@(T("Home"))</a><a href="@(Shell.Url("how"))" class="@Css(("on", nav == "how"))">@(T("How it works"))</a><a href="@(Shell.Url("register.hotel"))" class="@Css(("on", nav == "hotels"))">@(T("For Hotels"))</a><a href="@(Shell.Url("supplier.home"))" class="@Css(("on", nav == "suppliers"))">@(T("For Suppliers"))</a><a href="@(Shell.Url("contact"))" class="@Css(("on", nav == "contact"))">@(T("Contact"))</a></nav>
      <div class="hdr-r">
        <a href="@(Route("lang.switch", Locale() == "ar" ? "en" : "ar"))" class="btn b-ghost" lang="@(Locale() == "ar" ? "en" : "ar")"><i class="bi bi-translate"></i>@(Locale() == "ar" ? "English" : "العربية")</a>
        @if (IsSectionDefined("hdr_r") || ViewData["hdr_r"] != null) {<text>
          @Yield("hdr_r")
        </text>} else if (Auth().Check()) {<text>
          <form method="POST" action="@(Shell.Url("logout"))" class="m-0">@Html.AntiForgeryToken()<button class="btn b-ghost" type="submit">@(T("Log out"))</button></form>
          <a class="btn b-olive" href="@(RouteServiceProvider.HomeFor(Auth().User))">@(T("Go to dashboard"))</a>
        </text>} else {<text>
          <a class="btn b-ghost" href="@(Shell.Url("login"))">@(T("Log in"))</a><a class="btn b-olive" href="@(Shell.Url("register"))">@(T("Create account"))</a>
        </text>}
      </div>
      <button type="button" class="md-burger" data-md-toggle aria-label="@(T("Menu"))" aria-expanded="false"><i class="bi bi-list"></i></button>
    </div></header>
    <div class="md-backdrop"></div>
</text>}

@RenderBody()

@if (footer ?? false) {<text>
    <footer class="ftr"><div class="wrap">
      <div class="ftr-g">
        <div class="ftr-b">
          <div class="brand">@await Html.PartialAsync("~/Views/svg/logo-footer.cshtml", With(new Dictionary<string, object?> {  }))<span class="brand-n">@(T("Midad"))</span></div>
          <p>@(T("The supply procurement marketplace connecting hotels and suppliers across Saudi Arabia."))</p>
        </div>
        <div class="ftr-c"><h4>@(T("Platform"))</h4><a href="@(Shell.Url("how"))">@(T("How it works"))</a><a href="@(Shell.Url("register.hotel"))">@(T("For hotels"))</a><a href="@(Shell.Url("supplier.home"))">@(T("For suppliers"))</a>@if (footer == "full") {<text><a href="#">@(T("Pricing"))</a></text>}</div>
        <div class="ftr-c"><h4>@(T("Company"))</h4><a href="#">@(T("About Midad"))</a><a href="@(Shell.Url("contact"))">@(T("Contact us"))</a><a href="#">@(T("Help centre"))</a></div>
        <div class="ftr-c"><h4>@(T("Legal"))</h4><a href="#">@(T("Privacy policy"))</a><a href="#">@(T("Terms of service"))</a>@if (footer == "full") {<text><a href="#">@(T("VAT compliance"))</a></text>}</div>
      </div>
      <div class="ftr-bar"><span>@(T("© 2026 Midad · Jubail Industrial College"))</span><span>@(T("Built for MIS 451 Capstone Project"))</span></div>
    </div></footer>
</text>}

@await Html.PartialAsync("~/Views/Shared/_Scripts.cshtml", With(new Dictionary<string, object?> {  }))
</body>
</html>
