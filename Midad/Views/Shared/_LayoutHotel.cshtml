@* Source: resources/views/layouts/hotel.blade.php *@
@{
    string? md_area = Get<string?>("md_area");
    Shell.Who? md_user = Get<Shell.Who?>("md_user");
}
@*
  Hotel shell - md-hotel.css. Also the Admin area (blueprint §7). Markup: UI/02-uc1-create-supply-request.html
  lines 159-186 (aside.side, .top, .page). The sidebar is chosen by role; the active item comes from the route name.
  Views supply:  @section('crumb')  - the breadcrumb markup copied from the prototype
                 @section('content') - everything inside .page
*@
<!DOCTYPE html>
<html lang="@(Locale())" dir="@(Locale() == "ar" ? "rtl" : "ltr")">
<head>
@await Html.PartialAsync("~/Views/Shared/_Head.cshtml", With(new Dictionary<string, object?> { ["sheet"] = "md-hotel" }))
<style>.app{min-height:max(940px,100vh)}@* prototype frame is 940 px tall; keep the sidebar full height on taller windows *@</style>
</head>
<body>
@{ var md = md_user ?? Shell.User(); }
<div class="app">
    <aside class="side">
      <a href="@(Route("home"))" class="side-brand text-decoration-none">@await Html.PartialAsync("~/Views/svg/logo-sidebar.cshtml", With(new Dictionary<string, object?> {  }))<span class="side-name">@(T("Midad"))</span></a>
      @await Html.PartialAsync(ViewPath((md_area ?? Auth().User?.Role) == "Admin" ? "layouts.partials.side-admin" : "layouts.partials.side-hotel"), With(new Dictionary<string, object?> {  }))
    </aside>
    <div class="md-backdrop"></div>
    <div class="main">
      <div class="top">
        <button type="button" class="md-burger" data-md-toggle aria-label="@(T("Menu"))" aria-expanded="false"><i class="bi bi-list"></i></button>
        <div class="crumb">@Yield("crumb")</div>
        <div class="d-flex align-items-center gap-3">
          @await Html.PartialAsync("~/Views/Shared/_Bell.cshtml", With(new Dictionary<string, object?> { ["shell"] = "hotel" }))
          <div class="md-acct d-flex align-items-center gap-3" data-md-acct role="button" tabindex="0" aria-haspopup="true">
            <span class="avatar">@(md["initials"] ?? "")</span>
            <div style="font-size:13px;line-height:1.3;"><div style="font-weight:500;">@(md["name"] ?? "")</div><div style="color:var(--muted);font-size:12px;">@(md["org"] ?? "")</div></div>
            <div class="md-acct-menu">
              @Stack("acct-menu")
              <a href="@(Route("lang.switch", Locale() == "ar" ? "en" : "ar"))"  lang="@(Locale() == "ar" ? "en" : "ar")"><i class="bi bi-translate me-2"></i>@(Locale() == "ar" ? "English" : "العربية")</a>
              <form method="POST" action="@(Shell.Url("logout"))" class="m-0">@Html.AntiForgeryToken()<button type="submit"><i class="bi bi-box-arrow-right me-2"></i>@(T("Log out"))</button></form>
            </div>
          </div>
        </div>
      </div>
      <div class="page">
        @RenderBody()
      </div>
    </div>
</div>
@Stack("modals")
@await Html.PartialAsync("~/Views/Shared/_Scripts.cshtml", With(new Dictionary<string, object?> {  }))
</body>
</html>
