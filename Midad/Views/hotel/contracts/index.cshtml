
@{
    Paginator<Contract> contracts = Get<Paginator<Contract>>("contracts");
    int toSign = Get<int>("toSign");
    int total = Get<int>("total");
}

@{ Layout = "~/Views/Shared/_LayoutHotel.cshtml"; }
@{ ViewData["title"] = "Contracts"; }
@section crumb {<text><b>@(T("Contracts"))</b></text>}

        @await Html.PartialAsync("~/Views/Shared/_FlashHotel.cshtml", With(new Dictionary<string, object?> {  }))
        <div class="ph">
          <div><h1>@(T("Contracts"))</h1><p>@(T(total == 1 ? ":n contract" : ":n contracts", new Dictionary<string, object?> { ["n"] = total })) · @(T(":n waiting for your signature", new Dictionary<string, object?> { ["n"] = toSign }))</p></div>
        </div>
        @await Html.PartialAsync("~/Views/hotel/partials/bar.cshtml", With(new Dictionary<string, object?> { ["statuses"] = new[] { "Pending Signatures", "Signed", "Cancelled" } }))
        <div class="card-m">
          <div class="md-table-scroll">
          <table class="tbl">
            <thead><tr><th>@(T("Contract"))</th><th>@(T("Request"))</th><th>@(T("Supplier"))</th><th class="text-end">@(T("Value"))</th><th>@(T("Agreed delivery"))</th><th>@(T("Signatures"))</th><th>@(T("Status"))</th><th></th></tr></thead>
            <tbody>
              @if (Php.Any(contracts)) { foreach (var c in contracts) {<text>
              <tr data-href="@(Route("hotel.contracts.show", c))">
                <td class="num" style="font-weight:500">@(c.ContractNo)</td>
                <td class="num">@(c.Bid.Request.Code)<div style="font-size:12px;color:var(--muted)">@(c.Bid.Request.Supplies.First()?.SupplyName)</div></td>
                <td>@(c.Bid.Supplier.CompanyName)</td>
                <td class="text-end num">@(T("SAR")) @(Php.NumberFormat((decimal) c.ContractValue, 2))</td>
                <td class="num">@(c.AgreedDeliveryDate.TranslatedFormat("d M Y"))</td>
                <td style="font-size:13px">@await Html.PartialAsync("~/Views/hotel/contracts/_sigs.cshtml", With(new Dictionary<string, object?> { ["c"] = c }))</td>
                <td>@await Html.PartialAsync("~/Views/Shared/_StatusPill.cshtml", Component(new Dictionary<string, object?> { ["value"] = c.ContractStatus }))</td>
                <td class="text-end"><a href="@(Route("hotel.contracts.show", c))" aria-label="Open @(c.ContractNo)"><i class="bi bi-chevron-right" style="color:var(--faint)"></i></a></td>
              </tr>
              </text>} } else {<text>
              <tr><td colspan="8" style="color:var(--muted)">@(T("No contracts yet. A contract is generated when you accept a bid."))</td></tr>
              </text>}
            </tbody>
          </table>
          </div>
        </div>
        @await Html.PartialAsync("~/Views/Shared/_PgHotel.cshtml", With(new Dictionary<string, object?> { ["p"] = contracts, ["noun"] = "contracts" }))

