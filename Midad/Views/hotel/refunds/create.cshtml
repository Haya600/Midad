
@{
    decimal max = Get<decimal>("max");
    PurchaseOrder order = Get<PurchaseOrder>("order");
}

@{ Layout = "~/Views/Shared/_LayoutHotel.cshtml"; }
@{ ViewData["title"] = "Request a refund"; }
@section crumb {<text><a href="@(Route("hotel.orders.index"))" class="md-link" style="color:inherit">@(T("Orders"))</a> <span style="color:var(--faint)">/</span> <a href="@(Route("hotel.orders.show", order))" class="md-link" style="color:inherit">@(order.OrderNo)</a> <span style="color:var(--faint)">/</span> <b>@(T("Request refund"))</b></text>}
@{ var n = Php.Count(errors.Keys()); }

        <div class="ph"><div><h1>@(T("Request a refund"))</h1><p>@(T("Tell us what was wrong with the delivery. A Midad administrator reviews every request."))</p></div></div>
        @await Html.PartialAsync("~/Views/Shared/_FlashHotel.cshtml", With(new Dictionary<string, object?> {  }))
        @if (Php.B(n)) {<text>
        <div class="al al-dan mb-4"><i class="bi bi-exclamation-triangle-fill"></i><div><div class="al-t">@(T("This refund request could not be sent"))</div><div class="al-b">@(MidadRequest.Attention(n, errors.Has("evidence") ? "send it again. Everything you entered has been kept." : "send it again. Everything you entered has been kept except the photo."))</div></div></div>
        </text>}
        <form method="POST" action="@(Route("hotel.refunds.store", order))" enctype="multipart/form-data">
          @Html.AntiForgeryToken()
        <div class="row g-4">
          <div class="col-12 col-lg-8">
            <div class="card-m mb-3">
              <div class="card-h"><div class="card-t">@(T("Refund details"))</div></div>
              <div class="card-p">
                <div class="row g-3">
                  @await Html.PartialAsync("~/Views/Shared/_Field.cshtml", Component(new Dictionary<string, object?> { ["shell"] = "hotel", ["col"] = "col-12", ["name"] = "reason", ["label"] = "Reason", ["type"] = "textarea", ["rows"] = "4", ["placeholder"] = $"{Php.E(T("Which items were damaged or missing, and how many?"))}", ["hint"] = n ? null : "At least 20 characters", ["required"] = true, ["minlength"] = "20", ["maxlength"] = "1000" }))
                  @await Html.PartialAsync("~/Views/Shared/_Field.cshtml", Component(new Dictionary<string, object?> { ["shell"] = "hotel", ["col"] = "col-12 col-md-6", ["name"] = "requested_amount", ["label"] = "Refund amount", ["type"] = "number", ["post"] = "SAR", ["placeholder"] = "0.00", ["hint"] = n ? null : "Up to SAR " + Php.NumberFormat(max, 2), ["required"] = true, ["min"] = "0.01", ["max"] = max, ["step"] = "0.01", ["inputClass"] = "num" }))
                  @await Html.PartialAsync("~/Views/Shared/_Field.cshtml", Component(new Dictionary<string, object?> { ["shell"] = "hotel", ["col"] = "col-12 col-md-6", ["name"] = "evidence", ["label"] = "Evidence photo", ["type"] = "file", ["accept"] = "image/jpeg,image/png", ["hint"] = n ? null : "JPG or PNG, up to 5 MB", ["required"] = true }))
                </div>
              </div>
            </div>
            <div class="foot">
              <a class="btn btn-ghost" href="@(Route("hotel.orders.show", order))"><i class="bi bi-arrow-left me-2"></i>@(T("Cancel"))</a>
              <div class="d-flex gap-2"><button class="btn btn-primary" type="submit">@(T("Send refund request"))</button></div>
            </div>
          </div>
          <div class="col-12 col-lg-4">
            <div class="card-m card-p mb-3">
              <div class="card-t mb-3">@(T("Order"))</div>
              <dl class="kv mb-0">
                <dt>@(T("Order"))</dt><dd class="num">@(order.OrderNo)</dd>
                <dt>@(T("Supplier"))</dt><dd>@(order.Contract.Bid.Supplier.CompanyName)</dd>
                <dt>@(T("Items"))</dt><dd>@(order.Contract.Bid.Request.ItemsSummary())</dd>
                <dt>@(T("Invoice total"))</dt><dd class="num">@(T("SAR")) @(Php.NumberFormat((decimal) order.Invoice?.TotalAmount, 2))</dd>
                <dt>@(T("Can still be refunded"))</dt><dd class="num" style="margin-bottom:0">@(T("SAR")) @(Php.NumberFormat(max, 2))</dd>
              </dl>
            </div>
            <div class="al al-info"><i class="bi bi-info-circle-fill"></i><div><div class="al-t">@(T("What happens next"))</div><div class="al-b">@(T("An administrator checks your photo and the order, then approves or rejects the request. You can follow its status under Refunds."))</div></div></div>
          </div>
        </div>
        </form>

