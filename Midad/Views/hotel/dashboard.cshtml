@* Source: resources/views/hotel/dashboard.blade.php *@
@{
    int awaitingCount = Get<int>("awaitingCount");
    int awaitingRequests = Get<int>("awaitingRequests");
    int closingSoon = Get<int>("closingSoon");
    string? greeting = Get<string?>("greeting");
    Hotel hotel = Get<Hotel>("hotel");
    List<SupplyRequest> latest = Get<List<SupplyRequest>>("latest");
    int? oldestDays = Get<int?>("oldestDays");
    int openCount = Get<int>("openCount");
    decimal spend = Get<decimal>("spend");
    List<Chart.Point> spendChart = Get<List<Chart.Point>>("spendChart");
    int spendOrders = Get<int>("spendOrders");
    int toSignCount = Get<int>("toSignCount");
}
@* UC1-01 Hotel dashboard - UI/02-uc1-create-supply-request.html lines 186-209. *@
@{ Layout = "~/Views/Shared/_LayoutHotel.cshtml"; }
@{ ViewData["title"] = "Dashboard"; }
@section crumb {<text><b>@(T("Dashboard"))</b></text>}
@* @section('content') = the Razor body *@
        @await Html.PartialAsync("~/Views/Shared/_FlashHotel.cshtml", With(new Dictionary<string, object?> {  }))
        <div class="ph">
          <div><h1>@(T(greeting)), @(hotel.FirstName)</h1><p>@(hotel.HotelName) · @(Php.Now().TranslatedFormat("l, j F Y"))</p></div>
          <a class="btn btn-primary btn-lg" href="@(Route("hotel.requests.create"))"><i class="bi bi-plus-lg me-2"></i>@(T("New supply request"))</a>
        </div>

        <div class="row g-3 mb-4">
          <div class="col-12 col-sm-6 col-lg-3"><div class="card-m card-p"><div class="stat-k">@(T("Open requests"))</div><div class="stat-v">@(openCount)</div><div class="stat-d">@(T(":n closing this week", new Dictionary<string, object?> { ["n"] = closingSoon }))</div></div></div>
          <div class="col-12 col-sm-6 col-lg-3"><div class="card-m card-p"><div class="stat-k">@(T("Bids awaiting review"))</div><div class="stat-v">@(awaitingCount)</div><div class="stat-d">@(T(awaitingRequests == 1 ? "Across :n request" : "Across :n requests", new Dictionary<string, object?> { ["n"] = awaitingRequests }))</div></div></div>
          <div class="col-12 col-sm-6 col-lg-3"><div class="card-m card-p"><div class="stat-k">@(T("Contracts to sign"))</div><div class="stat-v">@(toSignCount)</div><div class="stat-d">@(Php.IsNull(oldestDays) ? T("None waiting") : (oldestDays == 0 ? T("Oldest today") : T(oldestDays == 1 ? "Oldest :n day ago" : "Oldest :n days ago", new Dictionary<string, object?> { ["n"] = oldestDays })))</div></div></div>
          <div class="col-12 col-sm-6 col-lg-3"><div class="card-m card-p"><div class="stat-k">@(T("Spend this quarter"))</div><div class="stat-v" style="font-size:25px;">@(T("SAR")) @(Php.NumberFormat(spend))</div><div class="stat-d">@(T(spendOrders == 1 ? "Across :n order" : "Across :n orders", new Dictionary<string, object?> { ["n"] = spendOrders }))</div></div></div>
        </div>

        @await Html.PartialAsync("~/Views/Shared/_BarChart.cshtml", Component(new Dictionary<string, object?> { ["title"] = "Spend by month", ["sub"] = "Last 6 months · paid invoices incl. VAT", ["points"] = spendChart, ["empty"] = "No payments in the last 6 months." }))

        <div class="card-m">
          <div class="card-h"><div class="card-t">@(T("Recent supply requests"))</div><a class="btn btn-ghost btn-sm" href="@(Route("hotel.requests.index"))">@(T("View all"))</a></div>
          <div class="md-table-scroll">
          <table class="tbl">
            <thead><tr><th>@(T("Request"))</th><th>@(T("Product"))</th><th class="text-end">@(T("Qty"))</th><th>@(T("Needed by"))</th><th>@(T("Priority"))</th><th class="text-end">@(T("Bids"))</th><th>@(T("Status"))</th></tr></thead>
            <tbody>
              @if (Php.Any(latest)) { foreach (var r in latest) {<text>
              <tr data-href="@(Route("hotel.requests.show", r))"><td class="num" style="font-weight:500">@(r.Code)</td><td>@await Html.PartialAsync("~/Views/hotel/requests/_product.cshtml", With(new Dictionary<string, object?> { ["r"] = r }))</td><td class="text-end num">@(r.QtyShort())</td><td class="num">@(r.RequiredDeliveryDate.TranslatedFormat("d M Y"))</td><td>@await Html.PartialAsync("~/Views/Shared/_StatusPill.cshtml", Component(new Dictionary<string, object?> { ["value"] = r.Priority, ["priority"] = true }))</td><td class="text-end num">@(r.Bids.Count)</td><td>@await Html.PartialAsync("~/Views/Shared/_StatusPill.cshtml", Component(new Dictionary<string, object?> { ["value"] = r.RequestStatus }))</td></tr>
              </text>} } else {<text>
              <tr><td colspan="7" style="color:var(--muted)">@(T("No supply requests yet"))</td></tr>
              </text>}
            </tbody>
          </table>
          </div>
        </div>
@* @endsection *@
