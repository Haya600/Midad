
@{
    string? phone = Get<string?>("phone");
    dynamic profile = ViewBag.profile;
    UserAccount user = Get<UserAccount>("user");
}

@{ Layout = "~/Views/Shared/_LayoutHotel.cshtml"; }
@{ ViewData["title"] = "Hotel Profile"; }
@section crumb {<text><b>@(T("Hotel Profile"))</b></text>}
@{ var n = Php.Count(Php.ArrayDiff(errors.Keys(), new[] { "phone_local", "confirm_email" })); }

        @await Html.PartialAsync("~/Views/Shared/_FlashHotel.cshtml", With(new Dictionary<string, object?> {  }))
        <div class="ph">
          <div><div class="d-flex align-items-center gap-3 mb-1 flex-wrap"><h1>@(profile.HotelName)</h1>@await Html.PartialAsync("~/Views/Shared/_StatusPill.cshtml", Component(new Dictionary<string, object?> { ["value"] = profile.ProfileStatus }))</div><p>@(T("Member since :date", new Dictionary<string, object?> { ["date"] = user.CreatedAt.TranslatedFormat("j M Y") })) · @(T(user.AccountStatus))</p></div>
        </div>
        @if (Php.B(n)) {<text>
        <div class="al al-dan mb-4"><i class="bi bi-exclamation-triangle-fill"></i><div><div class="al-t">@(T("Your profile could not be saved"))</div><div class="al-b">@(MidadRequest.Attention(n, "save again. Everything you entered has been kept."))</div></div></div>
        </text>} else if (profile.ProfileStatus != "Verified") {<text>
        <div class="al al-warn mb-4"><i class="bi bi-exclamation-circle-fill"></i><div><div class="al-t">@(T("Your hotel is being verified"))</div><div class="al-b">@(T("We verify every business before it can post requests, usually within one working day."))</div></div></div>
        </text>}
        <div class="row g-4">
          <div class="col-12 col-lg-8">
            <form method="POST" action="@(Route("hotel.profile.update"))">
              @Html.AntiForgeryToken() <input type="hidden" name="_method" value="PUT">
              <div class="card-m card-p mb-3">
                @await Html.PartialAsync("~/Views/Shared/_ProfileFields.cshtml", With(new Dictionary<string, object?> { ["shell"] = "hotel", ["kind"] = "hotel", ["profile"] = profile, ["user"] = user, ["phone"] = phone }))
              </div>
              <div class="foot" style="margin-top:0;border-top:0;padding-top:0">
                <button class="btn btn-ghost" type="button" style="color:var(--danger)" data-md-open="#closeAccount"><i class="bi bi-x-circle me-2"></i>@(T("Close account"))</button>
                <div class="d-flex gap-2"><button class="btn btn-primary" type="submit">@(T("Save changes"))</button></div>
              </div>
            </form>
          </div>
          <div class="col-12 col-lg-4">
            <div class="card-m card-p">
              <div class="card-t mb-3">@(T("Account"))</div>
              <dl class="kv mb-0">
                <dt>@(T("Profile status"))</dt><dd>@await Html.PartialAsync("~/Views/Shared/_StatusPill.cshtml", Component(new Dictionary<string, object?> { ["value"] = profile.ProfileStatus }))</dd>
                <dt>@(T("Account status"))</dt><dd>@await Html.PartialAsync("~/Views/Shared/_StatusPill.cshtml", Component(new Dictionary<string, object?> { ["value"] = user.AccountStatus }))</dd>
                <dt>@(T("Phone"))</dt><dd class="num">@(MidadPhone.Display(user.Phone))</dd>
                <dt>@(T("Supply requests"))</dt><dd class="num" style="margin-bottom:0">@(profile.SupplyRequests.Count())</dd>
              </dl>
            </div>
          </div>
        </div>

@{ Push("modals", @<text>
<div class="md-modal" id="closeAccount" hidden role="dialog" aria-modal="true" aria-labelledby="closeAccountT" @Html.Raw((errors.Has("confirm_email")) ? $" data-md-autoshow " : "")>
      <div class="scrim">
        <form class="mdl" method="POST" action="@(Route("hotel.profile.close"))">
          @Html.AntiForgeryToken()
          <div class="mdl-h"><div class="mdl-t" id="closeAccountT">@(T("Close your Midad account?"))</div></div>
          <div class="mdl-b">
            <p style="margin:0 0 16px;">@(T("You are signed out and can no longer post requests. Your contracts, orders and invoices are kept for your records; contact support to reopen the account."))</p>
            @await Html.PartialAsync("~/Views/Shared/_Field.cshtml", Component(new Dictionary<string, object?> { ["shell"] = "hotel", ["name"] = "confirm_email", ["label"] = "Type your email address to confirm", ["type"] = "email", ["placeholder"] = user.Email, ["required"] = true }))
          </div>
          <div class="mdl-f">
            <button class="btn btn-white" type="button" data-md-close>@(T("Keep account"))</button>
            <button class="btn btn-danger" type="submit">@(T("Close account"))</button>
          </div>
        </form>
      </div>
</div>
</text>); }
